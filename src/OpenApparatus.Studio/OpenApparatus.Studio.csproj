<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <!-- ColorPicker control package — provides ColorView / ColorPicker
         with HSV / HSL / RGB editors and a hue spectrum. Pulled in to
         replace the previous static-swatch picker. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.12" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.4" />
  </ItemGroup>

  <!--
    OpenApparatus.Core dependency.
    Until Core is published to NuGet, depend on a sibling clone of the
    openapparatus-core repo. Until that arrives, OPENAPPARATUS_CORE_PATH must
    point at the Core project's directory, or the openapparatus-core repo must
    be cloned at ../../openapparatus-core/ (the default).
  -->
  <PropertyGroup>
    <OpenApparatusCoreRepo Condition=" '$(OpenApparatusCoreRepo)' == '' ">$(MSBuildThisFileDirectory)..\..\..\openapparatus-core\</OpenApparatusCoreRepo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(OpenApparatusCoreRepo)src\OpenApparatus.Core\OpenApparatus.Core.csproj" />
    <ProjectReference Include="$(OpenApparatusCoreRepo)src\OpenApparatus.IO\OpenApparatus.IO.csproj" />
  </ItemGroup>
</Project>
