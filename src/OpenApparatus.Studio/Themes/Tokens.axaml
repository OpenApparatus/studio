<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        OpenApparatus Studio design tokens.

        A small, deliberate set of resources that every view should use
        instead of literal hex codes / pixel values / font sizes. The point
        is consistency: any time you reach for "another light grey" or
        "another margin," reach for one of these instead.

        Surfaces       — light chrome layers. Two only.
        Editor         — the dark canvas + status bar.
        Borders        — hairline grey for dividers, deeper grey for accents.
        Accent         — the brand blue and a darker hover.
        Text           — three-step grey scale.
        Validity       — green / red used by measurement coloring.
        Spacing        — 4 px grid.
        Font sizes     — four-step type scale.
        Corners        — three-step radius scale.
    -->

    <!-- ─── Surfaces ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SurfacePrimaryBrush"   Color="#F7F8FA"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#ECEEF3"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush"    Color="#FFFFFF"/>

    <!-- ─── Editor / dark surfaces ──────────────────────────────── -->
    <SolidColorBrush x:Key="EditorBgBrush"  Color="#1A1A1F"/>
    <SolidColorBrush x:Key="StatusBgBrush"  Color="#23232A"/>

    <!-- ─── Borders ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderHairlineBrush" Color="#D3D7DF"/>
    <SolidColorBrush x:Key="BorderStrongBrush"   Color="#A8AEBB"/>

    <!-- ─── Accent ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#1F6FEB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1C5FC7"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="#1850B0"/>

    <!-- ─── Text ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#23262E"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6270"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#7A808C"/>
    <SolidColorBrush x:Key="TextOnDarkBrush"    Color="#FFFFFF"/>

    <!-- ─── Validity (constraint-aware overlays) ────────────────── -->
    <SolidColorBrush x:Key="ValidBrush"   Color="#28A05A"/>
    <SolidColorBrush x:Key="InvalidBrush" Color="#C82828"/>

    <!-- ─── Spacing (4-px grid) ─────────────────────────────────── -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>

    <!-- Pre-baked Thickness convenience values for the common cases. -->
    <Thickness x:Key="PadSm">8</Thickness>
    <Thickness x:Key="PadMd">12</Thickness>
    <Thickness x:Key="PadLg">16</Thickness>
    <Thickness x:Key="PadStripH">14,8</Thickness>
    <Thickness x:Key="PadActionBar">12,6</Thickness>

    <!-- ─── Type scale ──────────────────────────────────────────── -->
    <x:Double x:Key="FontCaption">10.5</x:Double>
    <x:Double x:Key="FontBody">12</x:Double>
    <x:Double x:Key="FontBodyStrong">12</x:Double>
    <x:Double x:Key="FontTitle">14</x:Double>

    <!-- ─── Corner radii ────────────────────────────────────────── -->
    <CornerRadius x:Key="CornerSm">4</CornerRadius>
    <CornerRadius x:Key="CornerMd">8</CornerRadius>
    <CornerRadius x:Key="CornerLg">14</CornerRadius>
    <CornerRadius x:Key="CornerPill">16</CornerRadius>

    <!-- ─── Elevation (BoxShadows) ──────────────────────────────── -->
    <BoxShadows x:Key="Elevation1">0 1 2 0 #14000000</BoxShadows>
    <BoxShadows x:Key="Elevation2">0 4 14 0 #33000000</BoxShadows>

</ResourceDictionary>
