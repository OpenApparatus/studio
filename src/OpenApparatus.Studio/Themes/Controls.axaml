<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Application-wide control styling on top of FluentTheme. All
        colour values flow through {DynamicResource …} so the theme
        variant (Light / Dark) cascades cleanly when the user toggles
        it from the View menu.
    -->

    <!-- ── ScrollBar — slim hover-only thumb. -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="MinHeight" Value="6"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- ── ComboBox -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="10 4"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>
    <Style Selector="ComboBox:focus-within, ComboBox:pressed">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ── TextBox -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="8 4"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextOnDarkBrush}"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ── Button (default) -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10 5"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Generic button hover. Skips Buttons that opt into a class-named
         look (welcomeAction*, primary, action) so those keep their
         class-specific hover instead of the muted default. -->
    <Style Selector="Button:pointerover:not(.welcomeAction):not(.welcomeActionPrimary):not(.primary):not(.action):not(.toolIcon):not(.icon):not(.play) /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>
    <Style Selector="Button:pressed:not(.welcomeAction):not(.welcomeActionPrimary):not(.primary):not(.action):not(.toolIcon):not(.icon):not(.play) /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
    </Style>
    <!-- Welcome primary action — emerald accent at rest (set on the Button in
         WelcomePanel.cs), deep emerald on hover, deepest emerald-950 on press.
         The pointerover / pressed setters target the ContentPresenter so they
         beat the Fluent-theme default that would otherwise paint a light
         grey hover. -->
    <Style Selector="Button.welcomeActionPrimary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceInkBrush}"/>
    </Style>
    <Style Selector="Button.welcomeActionPrimary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceInkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceInkBrush}"/>
    </Style>
    <!-- Non-primary welcome actions — keep Fluent from painting the muted
         hover over the white surface that the code-behind sets. -->
    <Style Selector="Button.welcomeAction:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfacePressedBrush}"/>
    </Style>
    <Style Selector="Button.welcomeAction:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfacePressedBrush}"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!-- ── CheckBox -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ── ContextMenu / MenuFlyout -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="10 4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
    </Style>

    <!-- ── Expander — polished card-like header with hairline border,
         clean chevron, and a subtle hover surface. -->
    <Style Selector="Expander">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Padding" Value="12 10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
    </Style>
    <Style Selector="Expander /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- ── ToolTip — inverted on light theme; uses StatusBg on dark -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource StatusBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StatusBgBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8 5"/>
    </Style>

</Styles>
