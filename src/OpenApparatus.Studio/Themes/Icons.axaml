<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        OpenApparatus Studio icon library.

        Path geometries hand-traced from the Lucide icon set
        (https://lucide.dev — ISC licensed). Each icon is a 24×24 path
        intended to be rendered into a Path control via a binding like:

            <Path Width="16" Height="16"
                  Stretch="Uniform"
                  Fill="{StaticResource AccentBrush}"
                  Data="{StaticResource IconUndo}"/>

        Where size, fill, and stroke come from the host control. Using
        Path's Data slot keeps icons resolution-independent and
        stylable; replaces the previous Unicode-glyph approach which
        rendered inconsistently across platforms / font fallbacks.
    -->

    <!-- ── Editing / history ─────────────────────────────────────── -->

    <!-- Undo: arc-arrow-left-back -->
    <StreamGeometry x:Key="IconUndo">M9 14L4 9l5-5M4 9h10.5a5.5 5.5 0 0 1 0 11H11</StreamGeometry>
    <!-- Redo: arc-arrow-right-back -->
    <StreamGeometry x:Key="IconRedo">M15 14l5-5-5-5M20 9H9.5a5.5 5.5 0 0 0 0 11H13</StreamGeometry>
    <!-- Delete (trash) -->
    <StreamGeometry x:Key="IconTrash">M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6</StreamGeometry>
    <!-- Plus -->
    <StreamGeometry x:Key="IconPlus">M12 5v14M5 12h14</StreamGeometry>
    <!-- Close (X) -->
    <StreamGeometry x:Key="IconClose">M18 6L6 18M6 6l12 12</StreamGeometry>
    <!-- More (horizontal ellipsis) -->
    <StreamGeometry x:Key="IconMore">M12 12.01M19 12.01M5 12.01</StreamGeometry>
    <!-- Search -->
    <StreamGeometry x:Key="IconSearch">M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.35-4.35</StreamGeometry>

    <!-- ── File / project ────────────────────────────────────────── -->

    <!-- File / new -->
    <StreamGeometry x:Key="IconFile">M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6</StreamGeometry>
    <!-- Folder open -->
    <StreamGeometry x:Key="IconFolder">M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z</StreamGeometry>
    <!-- Save -->
    <StreamGeometry x:Key="IconSave">M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2zM17 21v-8H7v8M7 3v5h8</StreamGeometry>
    <!-- Download / export -->
    <StreamGeometry x:Key="IconDownload">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3</StreamGeometry>

    <!-- ── View / camera ─────────────────────────────────────────── -->

    <!-- Layout (grid) -->
    <StreamGeometry x:Key="IconLayout">M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z</StreamGeometry>
    <!-- Object (cube) -->
    <StreamGeometry x:Key="IconCube">M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16zM3.27 6.96L12 12.01l8.73-5.05M12 22.08V12</StreamGeometry>
    <!-- Eye (visibility) -->
    <StreamGeometry x:Key="IconEye">M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z</StreamGeometry>
    <!-- Eye-off -->
    <StreamGeometry x:Key="IconEyeOff">M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24M1 1l22 22</StreamGeometry>
    <!-- Move / 3D -->
    <StreamGeometry x:Key="IconMove">M5 9l-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3M2 12h20M12 2v20</StreamGeometry>

    <!-- ── Geometry primitives ───────────────────────────────────── -->

    <StreamGeometry x:Key="IconShapeCube">M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10</StreamGeometry>
    <StreamGeometry x:Key="IconShapeSphere">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM2 12h20M12 2c2.5 3 4 6.5 4 10s-1.5 7-4 10c-2.5-3-4-6.5-4-10s1.5-7 4-10z</StreamGeometry>
    <StreamGeometry x:Key="IconShapeCylinder">M12 2c4.4 0 8 1.3 8 3v14c0 1.7-3.6 3-8 3s-8-1.3-8-3V5c0-1.7 3.6-3 8-3zM4 5c0 1.7 3.6 3 8 3s8-1.3 8-3</StreamGeometry>

    <!-- ── Tools ─────────────────────────────────────────────────── -->

    <!-- Pointer / select -->
    <StreamGeometry x:Key="IconPointer">M3 3l7 19 2.5-8.5L21 11z</StreamGeometry>
    <!-- Settings (gear) -->
    <StreamGeometry x:Key="IconSettings">M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z</StreamGeometry>
    <!-- Help (?) -->
    <StreamGeometry x:Key="IconHelp">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01</StreamGeometry>
    <!-- Play (triangle) -->
    <StreamGeometry x:Key="IconPlay">M5 3l14 9-14 9z</StreamGeometry>
    <!-- Stop (square) -->
    <StreamGeometry x:Key="IconStop">M5 5h14v14H5z</StreamGeometry>
    <!-- Pause -->
    <StreamGeometry x:Key="IconPause">M6 4h4v16H6zM14 4h4v16h-4z</StreamGeometry>
    <!-- Refresh -->
    <StreamGeometry x:Key="IconRefresh">M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15</StreamGeometry>
    <!-- Color palette -->
    <StreamGeometry x:Key="IconPalette">M12 22a10 10 0 1 1 10-10c0 1.5-2 2-3 1.5L17 12c-1 .5-1 1.5-1 2.5s.5 2 1.5 2L18 17c.5 1 0 2-1.5 2-1.5 0-3-.5-3.5-1l-1-1zM7.5 10.5L8 11M11 7l.01.01M16.5 10.5L17 11M14 7l.01.01</StreamGeometry>
    <!-- Wrench (settings/tools) -->
    <StreamGeometry x:Key="IconWrench">M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z</StreamGeometry>

    <!-- ── Direction / chevrons ──────────────────────────────────── -->

    <StreamGeometry x:Key="IconChevronDown">M6 9l6 6 6-6</StreamGeometry>
    <StreamGeometry x:Key="IconChevronUp">M18 15l-6-6-6 6</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M9 18l6-6-6-6</StreamGeometry>
    <StreamGeometry x:Key="IconChevronLeft">M15 18l-6-6 6-6</StreamGeometry>

    <!-- ── Specialty ─────────────────────────────────────────────── -->

    <!-- Door -->
    <StreamGeometry x:Key="IconDoor">M18 20h2V4h-2M6 4H4v16h2M6 4h12v16H6zM14 12h.01</StreamGeometry>
    <!-- Window -->
    <StreamGeometry x:Key="IconWindow">M3 3h18v18H3zM12 3v18M3 12h18</StreamGeometry>
    <!-- Ruler / measurement -->
    <StreamGeometry x:Key="IconRuler">M21.3 8.7l-15-7a1 1 0 0 0-1.3.4l-2 4a1 1 0 0 0 .4 1.3l15 7a1 1 0 0 0 1.3-.4l2-4a1 1 0 0 0-.4-1.3zM7 12l3-1.5M11 14l3-1.5M15 16l3-1.5</StreamGeometry>
    <!-- Compass / angle -->
    <StreamGeometry x:Key="IconCompass">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36z</StreamGeometry>
    <!-- Path / route -->
    <StreamGeometry x:Key="IconPath">M9 18a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM21 6a3 3 0 1 0-6 0 3 3 0 0 0 6 0zM9 12V6M15 6H9M9 12h6a3 3 0 0 1 3 3v0a3 3 0 0 1-3 3</StreamGeometry>
    <!-- Maximize (fit) -->
    <StreamGeometry x:Key="IconMaximize">M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3</StreamGeometry>

    <!-- ── Information / status ──────────────────────────────────── -->

    <!-- Info circle -->
    <StreamGeometry x:Key="IconInfo">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 16v-4M12 8h.01</StreamGeometry>
    <!-- Alert triangle -->
    <StreamGeometry x:Key="IconAlert">M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4M12 17h.01</StreamGeometry>
    <!-- Check circle (success) -->
    <StreamGeometry x:Key="IconCheck">M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4L12 14.01l-3-3</StreamGeometry>
    <!-- Sparkles / new -->
    <StreamGeometry x:Key="IconSparkles">M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3L12 3zM5 3v4M19 17v4M3 5h4M17 19h4</StreamGeometry>

</ResourceDictionary>
