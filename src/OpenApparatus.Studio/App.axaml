<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenApparatus.Studio.App"
             xmlns:local="using:OpenApparatus.Studio"
             RequestedThemeVariant="Light">
             <!-- Default theme is Light. The View → Theme menu lets the
                  user flip to Dark; the choice is persisted in
                  AppSettings and re-applied on launch via
                  MainWindowViewModel.ApplyThemeVariant. Tokens.axaml
                  carries Light + Dark variants of every colour brush,
                  exposed via {DynamicResource} so the chrome flips
                  cleanly without a full re-render. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Design tokens: surfaces, accent, text, spacing, type
                     scale, corner radii, elevation. Every view should
                     consume these instead of literal hex/px values. -->
                <ResourceInclude Source="avares://OpenApparatus.Studio/Themes/Tokens.axaml"/>
                <!-- Icon library: SVG path geometries for every glyph
                     used in the UI. Replaces Unicode glyphs which
                     rendered inconsistently across systems. -->
                <ResourceInclude Source="avares://OpenApparatus.Studio/Themes/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Studio control theme — overrides Avalonia FluentTheme defaults
             for ScrollBar / ComboBox / TextBox / Button / MenuFlyout /
             ToolTip / Expander so the entire app matches the design
             tokens instead of falling back to system-stock chrome. -->
        <StyleInclude Source="avares://OpenApparatus.Studio/Themes/Controls.axaml"/>
    </Application.Styles>
</Application>