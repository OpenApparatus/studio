<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenApparatus.Studio.Views.WallColorDialog"
        Width="380" Height="540"
        Title="Pick colour"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfacePrimaryBrush}">
    <Grid Margin="14" RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0" x:Name="HeaderText"
                   FontWeight="SemiBold" FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0 0 0 10"/>

        <!-- Avalonia's built-in ColorView gives a real spectrum +
             saturation/value square + RGB / HSV / HSL editors.
             ColorChanged updates _current so Hex stays in sync. -->
        <ColorView Grid.Row="1" x:Name="Picker"
                   IsAlphaVisible="False"
                   IsAlphaEnabled="False"
                   ColorModel="Hsva"
                   ColorChanged="OnPickerColorChanged"
                   HorizontalAlignment="Stretch"/>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0 12 0 0" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="Hex" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox   Grid.Column="1" x:Name="HexInput" Watermark="#RRGGBB"/>
            <Border    Grid.Column="2" x:Name="Preview"
                       Width="36" Height="28"
                       BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1"
                       CornerRadius="4"
                       Background="#CCCCCC"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button Content="Reset to default" Click="OnReset"/>
            <Button Content="Cancel" Click="OnCancel"/>
            <Button Content="OK" Classes="primary" Click="OnOk" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
