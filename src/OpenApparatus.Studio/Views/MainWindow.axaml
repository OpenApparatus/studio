<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenApparatus.Studio.ViewModels"
        xmlns:views="using:OpenApparatus.Studio.Views"
        xmlns:converters="using:OpenApparatus.Studio.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="OpenApparatus.Studio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="780"
        Title="OpenApparatus Studio">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="0 8 0 2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1f6feb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10 6"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1c5fc7"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8 6"/>
        </Style>
        <!-- Mode tabs (Layout / Object) — bigger / more prominent than the
             old view tabs, since they switch what the whole UI is about. -->
        <Style Selector="RadioButton.modeTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#9aa1ab"/>
            <Setter Property="BorderThickness" Value="1 1 1 0"/>
            <Setter Property="CornerRadius" Value="6 6 0 0"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
            <Setter Property="Padding" Value="18 6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="RadioButton.modeTab:checked">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="RadioButton.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#c8c8cf"/>
            <Setter Property="BorderThickness" Value="1 1 1 0"/>
            <Setter Property="CornerRadius" Value="4 4 0 0"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
        </Style>
        <Style Selector="RadioButton.tab:checked">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Card-style border for the toolbar above the editor. Tighter
             paddings + a smaller checkbox font so the three cards fit on
             one horizontal line in standard window widths. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#cdd1d9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8 6"/>
            <Setter Property="Margin" Value="0 0 6 0"/>
        </Style>
        <Style Selector="Border.card CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4 0 0 0"/>
        </Style>
        <Style Selector="Border.card TextBlock">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TextBlock.cardHdr">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#5a6270"/>
            <Setter Property="Margin" Value="0 0 0 3"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Mode bar: Layout / Object toggle + mode-independent actions. -->
        <Border DockPanel.Dock="Top" Background="#dee0e6" BorderBrush="#a3aab4" BorderThickness="0 0 0 1" Padding="10 8 10 0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0">
                    <RadioButton GroupName="EditMode"
                                 Content="Layout"
                                 IsChecked="{Binding EditMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Layout}"
                                 Classes="modeTab"/>
                    <RadioButton GroupName="EditMode"
                                 Content="Object"
                                 IsChecked="{Binding EditMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Object}"
                                 Classes="modeTab"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0 0 0 8">
                    <Button Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (Ctrl+Z)"/>
                    <Button Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y / Ctrl+Shift+Z)"/>
                    <Separator Width="10"/>
                    <Button Content="Reset All" Command="{Binding ResetAllCommand}"/>
                    <Button Content="Random Fill" Command="{Binding RandomFillCommand}"
                            IsVisible="{Binding IsLayoutMode}"/>
                    <Separator Width="10"/>
                    <Button Content="Export glTF…"
                            Command="{Binding ExportGltfCommand}"
                            CommandParameter="{Binding $parent[Window]}"
                            ToolTip.Tip="Export as glTF with per-room scene hierarchy"/>
                    <Button Content="Export JSON…"
                            Command="{Binding ExportJsonCommand}"
                            CommandParameter="{Binding $parent[Window]}"
                            ToolTip.Tip="Save the authored scene as JSON"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar cards strip: View / Layout meas. / Object meas. Tightly
             packed so all three fit on one horizontal line at standard
             widths. Two-column layout inside each card keeps it compact. -->
        <Border DockPanel.Dock="Top" Background="#eef0f5" BorderBrush="#cdd1d9" BorderThickness="0 0 0 1" Padding="8 8 2 8">
            <StackPanel Orientation="Horizontal">

                <!-- View card -->
                <Border Classes="card">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="cardHdr" Text="VIEW"/>
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="2">
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="Wall borders"
                                      IsChecked="{Binding ShowWallBorders}"
                                      ToolTip.Tip="14-px coloured ribbons just inside each wall."/>
                            <CheckBox Grid.Row="0" Grid.Column="1" Content="Room labels"
                                      IsChecked="{Binding ShowRoomLabels}"
                                      ToolTip.Tip="Room id + name at room centre."/>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Border α" VerticalAlignment="Center" Foreground="#555"/>
                                <Slider Width="80" Minimum="0" Maximum="1" Margin="0"
                                        Value="{Binding WallBorderOpacity, Mode=TwoWay}"
                                        IsEnabled="{Binding ShowWallBorders}"
                                        ToolTip.Tip="Opacity of the wall border ribbons."/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Saturation" VerticalAlignment="Center" Foreground="#555"/>
                                <Slider Width="80" Minimum="0" Maximum="1" Margin="0"
                                        Value="{Binding TileSaturation, Mode=TwoWay}"
                                        ToolTip.Tip="Mute room tile colours."/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4">
                                <CheckBox Content="Paths"
                                          IsChecked="{Binding ShowPaths}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Connectivity polyline through traversable walls."/>
                                <Button Width="16" Height="16" Padding="0"
                                        BorderBrush="#888" BorderThickness="1"
                                        Background="{Binding PathColor, Converter={x:Static converters:Vector3ToBrushConverter.Instance}}"
                                        Click="OnPickPathColor"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Path colour"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Layout measurements card -->
                <Border Classes="card">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="cardHdr" Text="LAYOUT MEASUREMENTS"/>
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="2">
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="Room dims"
                                      IsChecked="{Binding ShowRoomDimensions}"
                                      ToolTip.Tip="W × D label per room."/>
                            <CheckBox Grid.Row="0" Grid.Column="1" Content="Floor area"
                                      IsChecked="{Binding ShowFloorAreaLabels}"
                                      ToolTip.Tip="m² label per room."/>
                            <CheckBox Grid.Row="1" Grid.Column="0" Content="Wall lengths"
                                      IsChecked="{Binding ShowWallLengthLabels}"
                                      ToolTip.Tip="Length per wall segment."/>
                            <CheckBox Grid.Row="1" Grid.Column="1" Content="Opening sizes"
                                      IsChecked="{Binding ShowOpeningSizeLabels}"
                                      ToolTip.Tip="Width × height per door / window."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Object measurements card -->
                <Border Classes="card">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="cardHdr" Text="OBJECT MEASUREMENTS"/>
                        <CheckBox Content="Show measurements"
                                  IsChecked="{Binding ShowMeasurements}"
                                  ToolTip.Tip="Door→object distance + angle and inter-object distance lines."/>
                        <CheckBox Content="Selected room only"
                                  IsChecked="{Binding MeasurementsSelectedRoomOnly}"
                                  IsEnabled="{Binding ShowMeasurements}"
                                  ToolTip.Tip="When on (and a room is selected) only that room's lines render."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#101014" Padding="8 4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#cccccc"/>
        </Border>

        <Grid ColumnDefinitions="280,*,260">
            <ScrollViewer Grid.Column="0" Background="#f4f4f7">
                <StackPanel Margin="12" Spacing="0">

                    <!-- ─── LAYOUT MODE LEFT PANEL ─── -->
                    <StackPanel IsVisible="{Binding IsLayoutMode}" Spacing="0">
                        <TextBlock Classes="label" Text="Actions"/>
                        <StackPanel Classes="section" Spacing="4">
                            <Button Content="Create Room from Selection (R)" Classes="primary"
                                    Command="{Binding CreateRoomFromSelectionCommand}"/>
                            <Button Content="Clear Selection (Esc)" Classes="action"
                                    Command="{Binding ClearSelectionCommand}"/>
                        </StackPanel>

                        <TextBlock Classes="label" Text="Tile colour view"/>
                        <StackPanel Classes="section">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <RadioButton GroupName="ViewSurfaceLayout"
                                             Content="Floor"
                                             IsChecked="{Binding ViewMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Floor}"
                                             Classes="tab" Padding="14 4"/>
                                <RadioButton GroupName="ViewSurfaceLayout"
                                             Content="Ceiling"
                                             IsChecked="{Binding ViewMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Ceiling}"
                                             Classes="tab" Padding="14 4"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Classes="label" Text="Grid"/>
                        <StackPanel Classes="section">
                            <TextBlock Text="Width (tiles)"/>
                            <NumericUpDown Value="{Binding GridWidth}" Minimum="1" Maximum="64" FormatString="0"/>
                            <TextBlock Text="Length (tiles)"/>
                            <NumericUpDown Value="{Binding GridLength}" Minimum="1" Maximum="64" FormatString="0"/>
                            <TextBlock Text="Tile size (m)"/>
                            <NumericUpDown Value="{Binding TileSize}" Minimum="0.5" Maximum="10" Increment="0.5" FormatString="0.0"/>
                        </StackPanel>

                        <TextBlock Classes="label" Text="Defaults for new rooms"/>
                        <StackPanel Classes="section">
                            <Button Content="Default floor color…" Classes="action"
                                    Click="OnPickDefaultFloor"
                                    ToolTip.Tip="Used as the floor color when a new room is created."/>
                            <Button Content="Default ceiling color…" Classes="action"
                                    Click="OnPickDefaultCeiling"
                                    ToolTip.Tip="Used as the ceiling color when a new room is created."/>
                        </StackPanel>

                        <TextBlock Classes="label" Text="Walls"/>
                        <StackPanel Classes="section">
                            <TextBlock Text="Wall thickness (m)"/>
                            <NumericUpDown Value="{Binding WallThickness}" Minimum="0.05" Maximum="2.0" Increment="0.05" FormatString="0.00"/>
                            <TextBlock Text="Wall height (m)"/>
                            <NumericUpDown Value="{Binding WallHeight}" Minimum="0.5" Maximum="6.0" Increment="0.5" FormatString="0.0"/>
                        </StackPanel>

                        <TextBlock Classes="label" Text="Doorways"/>
                        <StackPanel Classes="section">
                            <TextBlock Text="Door width (m)"/>
                            <NumericUpDown Value="{Binding DoorWidth}" Minimum="0.5" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                            <TextBlock Text="Door height (m)"/>
                            <NumericUpDown Value="{Binding DoorHeight}" Minimum="1.5" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                        </StackPanel>

                        <TextBlock Classes="label" Text="Windows"/>
                        <StackPanel Classes="section">
                            <TextBlock Text="Window width (m)"/>
                            <NumericUpDown Value="{Binding WindowWidth}" Minimum="0.3" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                            <TextBlock Text="Window head height (m)"/>
                            <NumericUpDown Value="{Binding WindowHeight}" Minimum="1.0" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                            <TextBlock Text="Sill height (m)"/>
                            <NumericUpDown Value="{Binding WindowSillHeight}" Minimum="0.1" Maximum="2.5" Increment="0.1" FormatString="0.0"/>
                        </StackPanel>

                        <TextBlock Classes="label" Text="How to use"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                                   Text="• Click+drag empty tiles to select. Press R to make a room from a rectangular selection."/>
                        <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                                   Text="• Click a wall to select it. D = door, W = window, O = open, C = closed."/>
                        <TextBlock TextWrapping="Wrap" Foreground="#444"
                                   Text="• Switch to Object mode to populate rooms with objects."/>
                    </StackPanel>

                    <!-- ─── OBJECT MODE LEFT PANEL ─── -->
                    <StackPanel IsVisible="{Binding IsObjectsMode}" Spacing="0">
                        <TextBlock Classes="label" Text="Defaults for new objects"/>
                        <StackPanel Classes="section">
                            <TextBlock Text="Default Y (m above floor)"/>
                            <NumericUpDown Value="{Binding DefaultObjectY}"
                                           Minimum="0" Maximum="3.0" Increment="0.05"
                                           FormatString="0.00"
                                           ToolTip.Tip="Initial height for newly placed objects."/>
                            <TextBlock Text="Sub-grid (per tile)" Margin="0 8 0 0"/>
                            <NumericUpDown Value="{Binding GridSubdivision}" Minimum="1" Maximum="8" Increment="1" FormatString="0"
                                           ToolTip.Tip="Each tile is divided into N×N sub-cells. 1 = no subdivision."/>
                            <Button Content="Snap objects to grid" Classes="action" Margin="0 6 0 0"
                                    Command="{Binding SnapObjectsToGridCommand}"
                                    ToolTip.Tip="Round every object's X/Z to the nearest sub-cell centre. Y is preserved."/>
                        </StackPanel>

                        <!-- Object types list (moved from right panel). The
                             panel itself is hosted as a UserControl so the
                             code-behind can rebuild rows dynamically. -->
                        <views:ObjectTypesPanel/>

                        <!-- Placement constraints (always visible in Object
                             mode — used to live in its own panel). -->
                        <views:ConstraintsPanel/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0" Background="#1a1a1f">
                        <views:GridEditorView EditVersion="{Binding EditVersion}" Margin="8"/>
                    </Border>
                    <Border Grid.Column="1" Background="#e6e6ea" BorderBrush="#c8c8cf" BorderThickness="1 0 0 0" Padding="6 10" Width="48">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Zoom" HorizontalAlignment="Center" Foreground="#444" FontSize="11"/>
                            <Button DockPanel.Dock="Bottom" Content="Reset" FontSize="10" Padding="4 2"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ResetViewCommand}"
                                    ToolTip.Tip="Reset zoom and pan to fit-to-view."/>
                            <Slider Orientation="Vertical"
                                    Minimum="0.5" Maximum="8.0"
                                    Value="{Binding ZoomFactor, Mode=TwoWay}"
                                    HorizontalAlignment="Center"
                                    Margin="0 6"/>
                        </DockPanel>
                    </Border>
                </Grid>
                <views:LegendBar Grid.Row="1"/>
            </Grid>

            <views:RoomEditorPanel Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
