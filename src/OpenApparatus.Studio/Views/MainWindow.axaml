<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenApparatus.Studio.ViewModels"
        xmlns:views="using:OpenApparatus.Studio.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="OpenApparatus.Studio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="700"
        Title="OpenApparatus Studio">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="0 8 0 2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>
        <!-- Primary action: Create Room. High-contrast so users find it immediately. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1f6feb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10 6"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1c5fc7"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8 6"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="R" Command="{Binding CreateRoomFromSelectionCommand}"/>
        <KeyBinding Gesture="D" Command="{Binding ToggleDoorOnSelectedWallCommand}"/>
        <KeyBinding Gesture="W" Command="{Binding ToggleWindowOnSelectedWallCommand}"/>
        <KeyBinding Gesture="O" Command="{Binding OpenSelectedWallCommand}"/>
        <KeyBinding Gesture="C" Command="{Binding CloseSelectedWallCommand}"/>
        <KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}"/>
    </Window.KeyBindings>

    <DockPanel LastChildFill="True">
        <!-- Top toolbar — light background so default Light-theme buttons are visible -->
        <Border DockPanel.Dock="Top" Background="#e6e6ea" BorderBrush="#c8c8cf" BorderThickness="0 0 0 1" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Create Room (R)" Classes="primary"
                        Command="{Binding CreateRoomFromSelectionCommand}"
                        ToolTip.Tip="Turn the current tile selection into a room (hotkey: R)"/>
                <Button Content="Clear Selection (Esc)"
                        Command="{Binding ClearSelectionCommand}"
                        ToolTip.Tip="Clear the current tile selection (hotkey: Escape)"/>
                <Separator Width="12"/>
                <Button Content="Reset All" Command="{Binding ResetAllCommand}"/>
                <Button Content="Random Fill" Command="{Binding RandomFillCommand}"/>
                <Separator Width="12"/>
                <Button Content="Export glTF…"
                        Command="{Binding ExportGltfCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Export as glTF (.glb / .gltf) with per-room scene hierarchy"/>
                <Button Content="Export JSON…"
                        Command="{Binding ExportJsonCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Save the authored grid + passages as JSON"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#101014" Padding="8 4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#cccccc"/>
        </Border>

        <!-- Main split: parameter panel + interactive grid editor -->
        <Grid ColumnDefinitions="280,*">
            <ScrollViewer Grid.Column="0" Background="#f4f4f7">
                <StackPanel Margin="12" Spacing="0">

                    <!-- Primary actions in the left panel for maximum discoverability -->
                    <TextBlock Classes="label" Text="Actions"/>
                    <StackPanel Classes="section" Spacing="4">
                        <Button Content="Create Room from Selection (R)" Classes="primary"
                                Command="{Binding CreateRoomFromSelectionCommand}"/>
                        <Button Content="Clear Selection (Esc)" Classes="action"
                                Command="{Binding ClearSelectionCommand}"/>
                        <Button Content="Random Fill" Classes="action"
                                Command="{Binding RandomFillCommand}"/>
                        <Button Content="Reset All" Classes="action"
                                Command="{Binding ResetAllCommand}"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Grid"/>
                    <StackPanel Classes="section">
                        <TextBlock Text="Width (tiles)"/>
                        <NumericUpDown Value="{Binding GridWidth}" Minimum="1" Maximum="64" FormatString="0"/>
                        <TextBlock Text="Length (tiles)"/>
                        <NumericUpDown Value="{Binding GridLength}" Minimum="1" Maximum="64" FormatString="0"/>
                        <TextBlock Text="Tile size (m)"/>
                        <NumericUpDown Value="{Binding TileSize}" Minimum="0.5" Maximum="10" Increment="0.5" FormatString="0.0"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Walls"/>
                    <StackPanel Classes="section">
                        <TextBlock Text="Wall thickness (m)"/>
                        <NumericUpDown Value="{Binding WallThickness}" Minimum="0.05" Maximum="2.0" Increment="0.05" FormatString="0.00"/>
                        <TextBlock Text="Wall height (m)"/>
                        <NumericUpDown Value="{Binding WallHeight}" Minimum="0.5" Maximum="6.0" Increment="0.5" FormatString="0.0"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Doorways"/>
                    <StackPanel Classes="section">
                        <TextBlock Text="Door width (m)"/>
                        <NumericUpDown Value="{Binding DoorWidth}" Minimum="0.5" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                        <TextBlock Text="Door height (m)"/>
                        <NumericUpDown Value="{Binding DoorHeight}" Minimum="1.5" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Windows"/>
                    <StackPanel Classes="section">
                        <TextBlock Text="Window width (m)"/>
                        <NumericUpDown Value="{Binding WindowWidth}" Minimum="0.3" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                        <TextBlock Text="Window head height (m)"/>
                        <NumericUpDown Value="{Binding WindowHeight}" Minimum="1.0" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                        <TextBlock Text="Sill height (m)"/>
                        <NumericUpDown Value="{Binding WindowSillHeight}" Minimum="0.1" Maximum="2.5" Increment="0.1" FormatString="0.0"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="How to use"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                               Text="• Click+drag empty tiles to select. Click+drag selected tiles to deselect."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                               Text="• When the selection is rectangular, press R or click Create Room."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                               Text="• Click a wall to select it (yellow highlight)."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                               Text="• With a wall selected: D = doorway, W = window, O = open (no wall), C = closed."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                               Text="• Adjacent windows merge into a single wider window."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444"
                               Text="• Random Fill generates a starter layout you can edit."/>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Background="#1a1a1f">
                <views:GridEditorView EditVersion="{Binding EditVersion}" Margin="8"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
