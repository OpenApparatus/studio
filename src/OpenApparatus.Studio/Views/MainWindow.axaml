<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenApparatus.Studio.ViewModels"
        xmlns:views="using:OpenApparatus.Studio.Views"
        xmlns:converters="using:OpenApparatus.Studio.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="OpenApparatus.Studio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="700"
        Title="OpenApparatus Studio">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="0 8 0 2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>
        <!-- Primary action: Create Room. High-contrast so users find it immediately. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1f6feb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10 6"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1c5fc7"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8 6"/>
        </Style>
        <!-- Tab-styled radio buttons for the Floor/Ceiling view toggle. -->
        <Style Selector="RadioButton.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#c8c8cf"/>
            <Setter Property="BorderThickness" Value="1 1 1 0"/>
            <Setter Property="CornerRadius" Value="4 4 0 0"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
        </Style>
        <Style Selector="RadioButton.tab:checked">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Shortcuts are wired in code-behind (not Window.KeyBindings) so that
         single-letter hotkeys (R / D / W / O / C / Escape) defer to any
         focused text input — typing a letter into the room name field
         shouldn't fire a wall command. -->


    <DockPanel LastChildFill="True">
        <!-- Top toolbar — light background so default Light-theme buttons are visible -->
        <Border DockPanel.Dock="Top" Background="#e6e6ea" BorderBrush="#c8c8cf" BorderThickness="0 0 0 1" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Create Room (R)" Classes="primary"
                        Command="{Binding CreateRoomFromSelectionCommand}"
                        ToolTip.Tip="Turn the current tile selection into a room (hotkey: R)"/>
                <Button Content="Clear Selection (Esc)"
                        Command="{Binding ClearSelectionCommand}"
                        ToolTip.Tip="Clear the current tile selection (hotkey: Escape)"/>
                <Separator Width="12"/>
                <Button Content="Reset All" Command="{Binding ResetAllCommand}"/>
                <Button Content="Random Fill" Command="{Binding RandomFillCommand}"/>
                <Separator Width="12"/>
                <Button Content="Export glTF…"
                        Command="{Binding ExportGltfCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Export as glTF (.glb / .gltf) with per-room scene hierarchy"/>
                <Button Content="Export JSON…"
                        Command="{Binding ExportJsonCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Save the authored grid + passages as JSON"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#101014" Padding="8 4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#cccccc"/>
        </Border>

        <!-- Main split: parameter panel + interactive grid editor + per-room editor.
             The right column is a fixed width so the editor area doesn't reflow
             every time a room or opening is selected — auto-fit layout would
             otherwise shift the grid every time the panel toggled visibility. -->
        <Grid ColumnDefinitions="280,*,260">
            <ScrollViewer Grid.Column="0" Background="#f4f4f7">
                <StackPanel Margin="12" Spacing="0">

                    <!-- Primary actions in the left panel for maximum discoverability -->
                    <TextBlock Classes="label" Text="Actions"/>
                    <StackPanel Classes="section" Spacing="4">
                        <Button Content="Create Room from Selection (R)" Classes="primary"
                                Command="{Binding CreateRoomFromSelectionCommand}"/>
                        <Button Content="Clear Selection (Esc)" Classes="action"
                                Command="{Binding ClearSelectionCommand}"/>
                        <Button Content="Random Fill" Classes="action"
                                Command="{Binding RandomFillCommand}"/>
                        <Button Content="Reset All" Classes="action"
                                Command="{Binding ResetAllCommand}"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Grid"/>
                    <StackPanel Classes="section">
                        <TextBlock Text="Width (tiles)"/>
                        <NumericUpDown Value="{Binding GridWidth}" Minimum="1" Maximum="64" FormatString="0"/>
                        <TextBlock Text="Length (tiles)"/>
                        <NumericUpDown Value="{Binding GridLength}" Minimum="1" Maximum="64" FormatString="0"/>
                        <TextBlock Text="Tile size (m)"/>
                        <NumericUpDown Value="{Binding TileSize}" Minimum="0.5" Maximum="10" Increment="0.5" FormatString="0.0"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Defaults for new rooms"/>
                    <StackPanel Classes="section">
                        <Button Content="Default floor color…" Classes="action"
                                Click="OnPickDefaultFloor"
                                ToolTip.Tip="Used as the floor color when a new room is created."/>
                        <Button Content="Default ceiling color…" Classes="action"
                                Click="OnPickDefaultCeiling"
                                ToolTip.Tip="Used as the ceiling color when a new room is created."/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Defaults for new objects"/>
                    <StackPanel Classes="section">
                        <TextBlock Text="Default Y (m above floor)"/>
                        <NumericUpDown Value="{Binding DefaultObjectY}"
                                       Minimum="0" Maximum="3.0" Increment="0.05"
                                       FormatString="0.00"
                                       ToolTip.Tip="Initial height for newly placed objects."/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Walls"/>
                    <StackPanel Classes="section">
                        <TextBlock Text="Wall thickness (m)"/>
                        <NumericUpDown Value="{Binding WallThickness}" Minimum="0.05" Maximum="2.0" Increment="0.05" FormatString="0.00"/>
                        <TextBlock Text="Wall height (m)"/>
                        <NumericUpDown Value="{Binding WallHeight}" Minimum="0.5" Maximum="6.0" Increment="0.5" FormatString="0.0"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Doorways"/>
                    <StackPanel Classes="section">
                        <TextBlock Text="Door width (m)"/>
                        <NumericUpDown Value="{Binding DoorWidth}" Minimum="0.5" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                        <TextBlock Text="Door height (m)"/>
                        <NumericUpDown Value="{Binding DoorHeight}" Minimum="1.5" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Windows"/>
                    <StackPanel Classes="section">
                        <TextBlock Text="Window width (m)"/>
                        <NumericUpDown Value="{Binding WindowWidth}" Minimum="0.3" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                        <TextBlock Text="Window head height (m)"/>
                        <NumericUpDown Value="{Binding WindowHeight}" Minimum="1.0" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                        <TextBlock Text="Sill height (m)"/>
                        <NumericUpDown Value="{Binding WindowSillHeight}" Minimum="0.1" Maximum="2.5" Increment="0.1" FormatString="0.0"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="How to use"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                               Text="• Click+drag empty tiles to select. Click+drag selected tiles to deselect."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                               Text="• When the selection is rectangular, press R or click Create Room."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                               Text="• Click a wall to select it (yellow highlight)."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                               Text="• With a wall selected: D = doorway, W = window, O = open (no wall), C = closed."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0 0 0 6"
                               Text="• Adjacent windows merge into a single wider window."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#444"
                               Text="• Random Fill generates a starter layout you can edit."/>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                <!-- View tabs: Floor / Ceiling. Each tile gets recolored to that
                     room's floor or ceiling color when the tab is active. -->
                <Border Grid.Row="0" Background="#e6e6ea" BorderBrush="#c8c8cf" BorderThickness="0 0 0 1" Padding="8 6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0">
                            <RadioButton GroupName="ViewMode"
                                         Content="Floor"
                                         IsChecked="{Binding ViewMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Floor}"
                                         Classes="tab" Padding="14 4"/>
                            <RadioButton GroupName="ViewMode"
                                         Content="Ceiling"
                                         IsChecked="{Binding ViewMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Ceiling}"
                                         Classes="tab" Padding="14 4"/>
                            <RadioButton GroupName="ViewMode"
                                         Content="Objects"
                                         IsChecked="{Binding ViewMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Objects}"
                                         Classes="tab" Padding="14 4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <CheckBox Content="Show path(s)"
                                      IsChecked="{Binding ShowPaths}"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Draw a polyline through every traversable wall (open or doorway) to visualize how rooms connect."/>
                            <Button x:Name="PathColorSwatch"
                                    Width="20" Height="20"
                                    Padding="0"
                                    BorderBrush="#888"
                                    BorderThickness="1"
                                    Background="{Binding PathColor, Converter={x:Static converters:Vector3ToBrushConverter.Instance}}"
                                    Click="OnPickPathColor"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Path overlay colour"/>
                            <TextBlock Text="Wall border opacity" VerticalAlignment="Center" Foreground="#444"/>
                            <Slider Width="160" Minimum="0" Maximum="1"
                                    Value="{Binding WallBorderOpacity, Mode=TwoWay}"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                    ToolTip.Tip="Editor-only — fades the coloured wall ribbons so doors / windows behind them are easier to see. Does not affect the exported colours."/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0" Background="#1a1a1f">
                        <views:GridEditorView EditVersion="{Binding EditVersion}" Margin="8"/>
                    </Border>
                    <Border Grid.Column="1" Background="#e6e6ea" BorderBrush="#c8c8cf" BorderThickness="1 0 0 0" Padding="6 10" Width="48">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Zoom" HorizontalAlignment="Center" Foreground="#444" FontSize="11"/>
                            <Button DockPanel.Dock="Bottom" Content="Reset" FontSize="10" Padding="4 2"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ResetViewCommand}"
                                    ToolTip.Tip="Reset zoom and pan to the default fit-to-view layout"/>
                            <Slider Orientation="Vertical"
                                    Minimum="0.5" Maximum="8.0"
                                    Value="{Binding ZoomFactor, Mode=TwoWay}"
                                    HorizontalAlignment="Center"
                                    Margin="0 6"
                                    ToolTip.Tip="Zoom in / out. Scroll over the editor or drag with middle / right mouse to pan."/>
                        </DockPanel>
                    </Border>
                </Grid>
                <!-- Legend strip below the grid, never overlapping the editor. -->
                <views:LegendBar Grid.Row="2"/>
            </Grid>

            <!-- Right-side editor: rooms when a room is selected, doors /
                 windows when an opening is selected, otherwise an empty
                 placeholder. Always rendered so the column width never
                 changes — the editor area's reserved space stays constant
                 regardless of selection state. -->
            <views:RoomEditorPanel Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
