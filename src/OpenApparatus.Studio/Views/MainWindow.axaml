<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenApparatus.Studio.ViewModels"
        xmlns:views="using:OpenApparatus.Studio.Views"
        xmlns:converters="using:OpenApparatus.Studio.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="OpenApparatus.Studio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="780"
        Title="OpenApparatus Studio">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="2 14 2 6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource FontBodyStrong}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>
        <!-- Elevated card surface used for grouped sections in the side
             panels. White surface, hairline border, Level-1 shadow, soft
             rounding. Replaces the flat panel-on-panel look. -->
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerMd}"/>
            <Setter Property="BoxShadow" Value="{StaticResource Elevation1}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>
        <!-- Card variant without shadow — for content that's already on a
             nested surface and shouldn't double-elevate. -->
        <Style Selector="Border.sectionFlat">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerMd}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>
        <!-- Two-column property grid (label | input). Replaces stacked
             label-then-NumericUpDown forms with a denser layout. -->
        <Style Selector="Grid.props">
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>
        <Style Selector="TextBlock.propLabel">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Compact NumericUpDown — half the default height so property
             grids read as a property sheet, not a form. -->
        <Style Selector="NumericUpDown.compact">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6 0"/>
            <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10 6"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8 6"/>
        </Style>
        <!-- Floating segmented mode toggle (Layout / Object) anchored at the
             top of the editor. Two RadioButtons sit flush against each other
             so they read as one connected control with a single seam in the
             middle. The unchecked half is light and raised; the checked half
             is dark with an inset shadow at the top, giving a "pressed in"
             feel. -->
        <Style Selector="RadioButton.modePill">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="#3a4150"/>
            <Setter Property="BorderBrush" Value="#a8aebb"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22 7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Left segment: rounded left, square right. -->
        <Style Selector="RadioButton.modePillLeft">
            <Setter Property="CornerRadius" Value="16 0 0 16"/>
        </Style>
        <!-- Right segment: square left, rounded right. Negative left margin
             pulls it onto the left segment so they share a single 1-px seam
             instead of doubling up. -->
        <Style Selector="RadioButton.modePillRight">
            <Setter Property="CornerRadius" Value="0 16 16 0"/>
            <Setter Property="Margin" Value="-1 0 0 0"/>
        </Style>
        <Style Selector="RadioButton.modePill:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#eef0f6"/>
        </Style>
        <!-- Pressed-in checked state: dark fill + inset shadow at the top
             edge so the button looks recessed into the editor surface. -->
        <Style Selector="RadioButton.modePill:checked /template/ Border#PART_Border">
            <Setter Property="Background" Value="#2a3242"/>
            <Setter Property="BorderBrush" Value="#171c26"/>
            <Setter Property="BoxShadow" Value="inset 0 2 4 0 #66000000"/>
        </Style>
        <Style Selector="RadioButton.modePill:checked /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
        <Style Selector="RadioButton.modePill:checked:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#323b4d"/>
        </Style>
        <Style Selector="RadioButton.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1 1 1 0"/>
            <Setter Property="CornerRadius" Value="4 4 0 0"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
        </Style>
        <Style Selector="RadioButton.tab:checked">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Section caption above each toolbar group. Tiny, uppercase, grey. -->
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 8 0"/>
        </Style>
        <!-- Inline label for sliders ("Opacity", "Saturation", etc.). -->
        <Style Selector="TextBlock.sliderLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8 0 5 0"/>
        </Style>
        <!-- Vertical hairline divider between toolbar sections. -->
        <Style Selector="Border.vsep">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BorderHairlineBrush}"/>
            <Setter Property="Margin" Value="10 2"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <!-- Pill-style toggle buttons: a single chip with the label inside.
             Lit blue when checked. -->
        <Style Selector="ToggleButton.pill">
            <Setter Property="Padding" Value="9 3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#c8ccd6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.pill:checked">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="ToggleButton.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#eef2f7"/>
        </Style>
        <Style Selector="ToggleButton.pill:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
        </Style>
        <!-- Mutual-exclusion pill — same look as ToggleButton.pill but for
             RadioButton, so a group of pills bound to one enum (e.g.
             Floor/Ceiling) reads as a connected segmented selector. -->
        <Style Selector="RadioButton.pill">
            <Setter Property="Padding" Value="9 3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#c8ccd6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.pill:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#eef2f7"/>
        </Style>
        <Style Selector="RadioButton.pill:checked /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="RadioButton.pill:checked /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}"/>
        </Style>
        <Style Selector="RadioButton.pill:checked:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
        </Style>

        <!-- Slim modern slider — full ControlTemplate replacement so we don't
             have to fight the Fluent default's chunky red thumb. Both
             orientations supported. Thin (3 px) track, small (12 px) flat
             blue thumb with a white halo. -->
        <Style Selector="Slider">
            <Setter Property="Background" Value="#dde1e8"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Slider:horizontal">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="0">
                        <Border Height="3" CornerRadius="1.5" Background="#dde1e8" VerticalAlignment="Center"/>
                        <Track Name="PART_Track" Orientation="Horizontal"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Width="12" Height="12" CornerRadius="6"
                                                Background="{StaticResource AccentBrush}"
                                                BorderBrush="White" BorderThickness="1.5"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider:vertical">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="0">
                        <Border Width="3" CornerRadius="1.5" Background="#dde1e8" HorizontalAlignment="Center"/>
                        <Track Name="PART_Track" Orientation="Vertical"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Width="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Width="12" Height="12" CornerRadius="6"
                                                Background="{StaticResource AccentBrush}"
                                                BorderBrush="White" BorderThickness="1.5"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Compact icon button used for the path play/stop + colour swatch. -->
        <Style Selector="Button.icon">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <!-- Top-bar icon button (undo/redo/overflow). Glyph-only, square,
             tight padding so they read as a tool palette rather than form
             buttons. -->
        <Style Selector="Button.toolIcon">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerSm}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.toolIcon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
        </Style>
        <Style Selector="Button.toolIcon:disabled">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Top action bar. Undo/Redo as tool-palette icon buttons (glyphs
             only). Random Fill stays visible in Layout mode. Reset All is
             demoted into an overflow menu (destructive, rarely used).
             Export glTF is the primary filled action; JSON export is the
             secondary alongside it. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0 0 0 1" Padding="12 6">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Classes="toolIcon" Content="↶"
                        Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                        ToolTip.Tip="Undo (Ctrl+Z)"/>
                <Button Classes="toolIcon" Content="↷"
                        Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                        ToolTip.Tip="Redo (Ctrl+Y / Ctrl+Shift+Z)"/>
                <Border Classes="vsep" Margin="6 4"/>
                <Button Content="Random Fill" Command="{Binding RandomFillCommand}"
                        IsVisible="{Binding IsLayoutMode}"
                        Padding="10 5"
                        ToolTip.Tip="Generate a random room layout"/>
                <Button Classes="toolIcon" Content="⋯" ToolTip.Tip="More actions">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Reset all" Command="{Binding ResetAllCommand}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Border Classes="vsep" Margin="6 4"/>
                <Button Content="Export glTF…" Classes="primary"
                        Padding="12 5"
                        HorizontalAlignment="Center"
                        Command="{Binding ExportGltfCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Export as glTF with per-room scene hierarchy"/>
                <Button Content="Export JSON…"
                        Padding="10 5"
                        Command="{Binding ExportJsonCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Save the authored scene as JSON"/>
            </StackPanel>
        </Border>

        <!-- Modern single-row settings strip. Sections separated by hairline
             dividers; each section labelled with a tiny uppercase caption. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfacePrimaryBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0 0 0 1" Padding="14 8">
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">

                    <!-- VIEW -->
                    <TextBlock Classes="sectionLabel" Text="VIEW"/>
                    <!-- Floor / Ceiling surface toggle (Layout mode only). It's
                         a viewport setting, so it lives in the top strip — not
                         the global authoring panel where it used to sit. -->
                    <RadioButton GroupName="ViewSurface"
                                 Classes="pill"
                                 Content="Floor"
                                 IsVisible="{Binding IsLayoutMode}"
                                 IsChecked="{Binding ViewMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Floor}"
                                 ToolTip.Tip="Show the floor surface tile colours."/>
                    <RadioButton GroupName="ViewSurface"
                                 Classes="pill"
                                 Content="Ceiling"
                                 Margin="0 0 6 0"
                                 IsVisible="{Binding IsLayoutMode}"
                                 IsChecked="{Binding ViewMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Ceiling}"
                                 ToolTip.Tip="Show the ceiling surface tile colours."/>
                    <ToggleButton Classes="pill" Content="Borders"
                                  IsChecked="{Binding ShowWallBorders}"
                                  ToolTip.Tip="14-px coloured ribbons inside each wall."/>
                    <ToggleButton Classes="pill" Content="Labels"
                                  IsChecked="{Binding ShowRoomLabels}"
                                  ToolTip.Tip="Room id + name at room centre."/>
                    <TextBlock Classes="sliderLabel" Text="Opacity"/>
                    <Slider Width="76" Minimum="0" Maximum="1"
                            Value="{Binding WallBorderOpacity, Mode=TwoWay}"
                            IsEnabled="{Binding ShowWallBorders}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Wall border opacity."/>
                    <TextBlock Classes="sliderLabel" Text="Saturation"/>
                    <Slider Width="76" Minimum="0" Maximum="1"
                            Value="{Binding TileSaturation, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Tile colour saturation."/>

                    <Border Classes="vsep"/>

                    <!-- LAYOUT -->
                    <TextBlock Classes="sectionLabel" Text="LAYOUT"/>
                    <ToggleButton Classes="pill" Content="Dimensions"
                                  IsChecked="{Binding ShowRoomDimensions}"
                                  ToolTip.Tip="W × D label per room."/>
                    <ToggleButton Classes="pill" Content="Area"
                                  IsChecked="{Binding ShowFloorAreaLabels}"
                                  ToolTip.Tip="m² label per room."/>
                    <ToggleButton Classes="pill" Content="Openings"
                                  IsChecked="{Binding ShowOpeningSizeLabels}"
                                  ToolTip.Tip="Width × height per door / window."/>

                    <Border Classes="vsep"/>

                    <!-- OBJECTS -->
                    <TextBlock Classes="sectionLabel" Text="OBJECTS"/>
                    <ToggleButton Classes="pill" Content="Distances"
                                  IsChecked="{Binding ShowObjectDistances}"
                                  ToolTip.Tip="Inter-object distance line + label."/>
                    <ToggleButton Classes="pill" Content="Door angles"
                                  IsChecked="{Binding ShowDoorAngles}"
                                  ToolTip.Tip="Angle arc + |angle| label at every door, plus 0° tick."/>
                    <ToggleButton Classes="pill" Content="Door distances"
                                  IsChecked="{Binding ShowDoorDistances}"
                                  ToolTip.Tip="Door→object line + distance label."/>

                    <Border Classes="vsep"/>

                    <!-- PATHS -->
                    <TextBlock Classes="sectionLabel" Text="PATHS"/>
                    <ToggleButton Classes="pill" Content="Show"
                                  IsChecked="{Binding ShowPaths}"
                                  ToolTip.Tip="Polyline through every traversable wall (open / doorway)."/>
                    <Button Classes="icon" Margin="2 0 0 0"
                            BorderBrush="#888" BorderThickness="1"
                            Background="{Binding PathColor, Converter={x:Static converters:Vector3ToBrushConverter.Instance}}"
                            Click="OnPickPathColor"
                            ToolTip.Tip="Path overlay colour"/>
                    <Button Classes="icon" Margin="4 0 0 0"
                            Command="{Binding TogglePathAnimationCommand}"
                            Content="{Binding IsPathAnimating, Converter={x:Static converters:BoolToTextConverter.Instance}, ConverterParameter='■|▶'}"
                            ToolTip.Tip="Animate the path overlay outward from the start room. Loops while running."/>

                </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource StatusBgBrush}" Padding="12 6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#cccccc"/>
        </Border>

        <Grid ColumnDefinitions="280,*,260">
            <ScrollViewer Grid.Column="0" Background="{StaticResource SurfacePrimaryBrush}">
                <StackPanel Margin="12" Spacing="0">

                    <!-- ─── LAYOUT MODE LEFT PANEL ─── -->
                    <StackPanel IsVisible="{Binding IsLayoutMode}" Spacing="0">
                        <TextBlock Classes="label" Text="Actions"/>
                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <Button Content="Create Room from Selection (R)" Classes="primary"
                                        Command="{Binding CreateRoomFromSelectionCommand}"/>
                                <Button Content="Clear Selection (Esc)" Classes="action"
                                        Command="{Binding ClearSelectionCommand}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="label" Text="Defaults for new rooms"/>
                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <Button Content="Default floor color…" Classes="action"
                                        Click="OnPickDefaultFloor"
                                        ToolTip.Tip="Used as the floor color when a new room is created."/>
                                <Button Content="Default ceiling color…" Classes="action"
                                        Click="OnPickDefaultCeiling"
                                        ToolTip.Tip="Used as the ceiling color when a new room is created."/>
                            </StackPanel>
                        </Border>

                        <!-- Document settings — set-once-and-forget dimensions
                             grouped under a single collapsed Expander so the
                             panel surfaces frequent actions instead of these. -->
                        <Expander Header="Document settings" Margin="0 12 0 4">
                            <StackPanel Spacing="0">
                                <TextBlock Classes="label" Text="Grid"/>
                                <Border Classes="sectionFlat">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="propLabel" Text="Width (tiles)"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="compact"
                                                       Value="{Binding GridWidth}" Minimum="1" Maximum="64" FormatString="0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="Length (tiles)"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="compact"
                                                       Value="{Binding GridLength}" Minimum="1" Maximum="64" FormatString="0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="propLabel" Text="Tile size (m)"/>
                                        <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="compact"
                                                       Value="{Binding TileSize}" Minimum="0.5" Maximum="10" Increment="0.5" FormatString="0.0"/>
                                    </Grid>
                                </Border>

                                <TextBlock Classes="label" Text="Walls"/>
                                <Border Classes="sectionFlat">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="propLabel" Text="Thickness (m)"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="compact"
                                                       Value="{Binding WallThickness}" Minimum="0.05" Maximum="2.0" Increment="0.05" FormatString="0.00"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="Height (m)"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="compact"
                                                       Value="{Binding WallHeight}" Minimum="0.5" Maximum="6.0" Increment="0.5" FormatString="0.0"/>
                                    </Grid>
                                </Border>

                                <TextBlock Classes="label" Text="Doorways"/>
                                <Border Classes="sectionFlat">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="propLabel" Text="Width (m)"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="compact"
                                                       Value="{Binding DoorWidth}" Minimum="0.5" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="Height (m)"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="compact"
                                                       Value="{Binding DoorHeight}" Minimum="1.5" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                                    </Grid>
                                </Border>

                                <TextBlock Classes="label" Text="Windows"/>
                                <Border Classes="sectionFlat">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="propLabel" Text="Width (m)"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="compact"
                                                       Value="{Binding WindowWidth}" Minimum="0.3" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="Head height (m)"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="compact"
                                                       Value="{Binding WindowHeight}" Minimum="1.0" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="propLabel" Text="Sill height (m)"/>
                                        <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="compact"
                                                       Value="{Binding WindowSillHeight}" Minimum="0.1" Maximum="2.5" Increment="0.1" FormatString="0.0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <TextBlock Classes="label" Text="How to use"/>
                        <Border Classes="sectionFlat">
                            <StackPanel Spacing="6">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}"
                                           Text="• Click+drag empty tiles to select. Press R to make a room from a rectangular selection."/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}"
                                           Text="• Click a wall to select it. D = door, W = window, O = open, C = closed."/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}"
                                           Text="• Switch to Object mode to populate rooms with objects."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ─── OBJECT MODE LEFT PANEL ─── -->
                    <StackPanel IsVisible="{Binding IsObjectsMode}" Spacing="0">
                        <TextBlock Classes="label" Text="Defaults for new objects"/>
                        <Border Classes="section">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*"
                                      RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="propLabel" Text="Default Y (m)"
                                               ToolTip.Tip="Initial height above floor for newly placed objects."/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="compact"
                                                   Value="{Binding DefaultObjectY}"
                                                   Minimum="0" Maximum="3.0" Increment="0.05" FormatString="0.00"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="Sub-grid (per tile)"
                                               ToolTip.Tip="Each tile is divided into N×N sub-cells. 1 = no subdivision."/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="compact"
                                                   Value="{Binding GridSubdivision}" Minimum="1" Maximum="8" Increment="1" FormatString="0"/>
                                </Grid>
                                <Button Content="Snap objects to grid" Classes="action"
                                        Command="{Binding SnapObjectsToGridCommand}"
                                        ToolTip.Tip="Round every object's X/Z to the nearest sub-cell centre. Y is preserved."/>
                            </StackPanel>
                        </Border>

                        <!-- Object types list (moved from right panel). The
                             panel itself is hosted as a UserControl so the
                             code-behind can rebuild rows dynamically. -->
                        <views:ObjectTypesPanel/>

                        <!-- Placement constraints (always visible in Object
                             mode — used to live in its own panel). -->
                        <views:ConstraintsPanel/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0" Background="{StaticResource EditorBgBrush}">
                        <Grid>
                            <views:GridEditorView EditVersion="{Binding EditVersion}" Margin="8"/>
                            <!-- Floating Layout / Object segmented control,
                                 anchored top-centre over the editor. The
                                 outer Border carries a soft drop shadow so
                                 the control reads as elevated above the
                                 dark editor surface. -->
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0 14 0 0"
                                    CornerRadius="16"
                                    BoxShadow="0 4 14 0 #55000000">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="EditMode"
                                                 Content="Layout"
                                                 Classes="modePill modePillLeft"
                                                 IsChecked="{Binding EditMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Layout}"/>
                                    <RadioButton GroupName="EditMode"
                                                 Content="Object"
                                                 Classes="modePill modePillRight"
                                                 IsChecked="{Binding EditMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Object}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1 0 0 0" Padding="6 10" Width="48">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Zoom" HorizontalAlignment="Center" Foreground="#444" FontSize="11"/>
                            <Button DockPanel.Dock="Bottom" Content="Reset" FontSize="10" Padding="4 2"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ResetViewCommand}"
                                    ToolTip.Tip="Reset zoom and pan to fit-to-view."/>
                            <Slider Orientation="Vertical"
                                    Minimum="0.5" Maximum="8.0"
                                    Value="{Binding ZoomFactor, Mode=TwoWay}"
                                    HorizontalAlignment="Center"
                                    Margin="0 6"/>
                        </DockPanel>
                    </Border>
                </Grid>
                <views:LegendBar Grid.Row="1"/>
            </Grid>

            <views:RoomEditorPanel Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
