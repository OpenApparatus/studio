<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenApparatus.Studio.ViewModels"
        xmlns:views="using:OpenApparatus.Studio.Views"
        xmlns:converters="using:OpenApparatus.Studio.Converters"
        xmlns:behaviors="using:OpenApparatus.Studio.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="OpenApparatus.Studio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="780"
        Title="{Binding WindowTitle, FallbackValue='OpenApparatus Studio'}">

    <Window.KeyBindings>
        <KeyBinding Gesture="F1" Command="{Binding ToggleShortcutOverlayCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}"
                    CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}"
                    CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}"
                    CommandParameter="{Binding $parent[Window]}"/>
        <!-- Ctrl+0 actual-size; Ctrl+1 fit. F is gated by focus and
             handled in OnGlobalKey so it doesn't fire inside TextBoxes. -->
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomActualSizeCommand}"/>
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding ResetViewCommand}"/>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="2 14 2 6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource FontBodyStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>
        <!-- Elevated card surface used for grouped sections in the side
             panels. White surface, hairline border, Level-1 shadow, soft
             rounding. Replaces the flat panel-on-panel look. -->
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerMd}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource Elevation1}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>
        <!-- Card variant without shadow — for content that's already on a
             nested surface and shouldn't double-elevate. -->
        <Style Selector="Border.sectionFlat">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerMd}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>
        <!-- Two-column property grid (label | input). Replaces stacked
             label-then-NumericUpDown forms with a denser layout. -->
        <Style Selector="Grid.props">
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>
        <Style Selector="TextBlock.propLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- propLabel that's wired to a DragScrub target should hint at
             that with a hover colour shift — gives the user a reason to
             try dragging. Cursor change is handled by DragScrub itself. -->
        <Style Selector="TextBlock.propLabel:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
        <!-- Compact NumericUpDown — horizontal stepper layout: number cell
             on the left, then a − cell, then a + cell, all under one
             rounded outer border with hairline vertical dividers between
             them. The clicks work because we wrap the TextBox in a real
             ButtonSpinner — NumericUpDown finds it as PART_Spinner and
             listens to its Spin events; the spinner's own template owns
             the PART_IncreaseButton / PART_DecreaseButton parts so its
             internal click → Spin wiring stays intact. -->
        <Style Selector="NumericUpDown.compact">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerSm}"/>
            <Setter Property="behaviors:NumericExpression.Enabled" Value="True"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="NumericUpDown">
                    <ButtonSpinner Name="PART_Spinner"
                                   Classes="compactSpinner"
                                   Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   CornerRadius="{TemplateBinding CornerRadius}"
                                   ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                                   ButtonSpinnerLocation="Right"
                                   HorizontalContentAlignment="Stretch"
                                   VerticalContentAlignment="Stretch"
                                   Padding="0">
                        <TextBox Name="PART_TextBox"
                                 Classes="compactInner"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Padding="10,4"
                                 MinHeight="0"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 Text="{TemplateBinding Text, Mode=TwoWay}"
                                 Watermark="{TemplateBinding Watermark}"/>
                    </ButtonSpinner>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Outer border stays at its resting hairline regardless of
             interaction. Hover and focus pseudoclasses on the spinner
             would bolden / accent the whole frame even when the user is
             only pressing a step button — visually noisy and conflated
             with the local button feedback the user expects. The
             stepper buttons own their own hover / press tints; the
             TextBox shows its own caret while typing. -->

        <!-- ButtonSpinner template for compact NumericUpDown — three-cell
             stepper layout. Hairline dividers between cells use the
             hairline brush directly so they don't darken when the outer
             border bolds on hover. -->
        <Style Selector="ButtonSpinner.compactSpinner">
            <Setter Property="Template">
                <ControlTemplate TargetType="ButtonSpinner">
                    <Border Name="PART_BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <ContentPresenter Grid.Column="0"
                                              Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"
                                              Padding="0"/>
                            <Border Grid.Column="1"
                                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                                    BorderThickness="1,0,1,0"
                                    IsVisible="{TemplateBinding ShowButtonSpinner}">
                                <RepeatButton Name="PART_DecreaseButton"
                                              Classes="numStep"
                                              Content="−"/>
                            </Border>
                            <RepeatButton Grid.Column="2"
                                          Name="PART_IncreaseButton"
                                          Classes="numStep"
                                          Content="+"
                                          IsVisible="{TemplateBinding ShowButtonSpinner}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Inner TextBox of the compact NumericUpDown — borderless and
             transparent in every state so the only visible chrome is the
             outer ButtonSpinner border. Without these :pointerover /
             :focus overrides, Fluent's default TextBox styles paint a
             second border / fill over the spinner's. -->
        <Style Selector="TextBox.compactInner /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.compactInner:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.compactInner:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Stepper buttons — square tap targets sized to the host height,
             larger glyph than the old chevrons so − / + read clearly.
             Focusable=False so a click doesn't transfer keyboard focus to
             the button, which would otherwise trigger the spinner's
             :focus-within accent border. The TextBox can still take
             focus normally (typing → accent ring), which is the intent. -->
        <Style Selector="RepeatButton.numStep">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <Style Selector="RepeatButton.numStep:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="RepeatButton.numStep:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10 6"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8 6"/>
        </Style>
        <!-- Floating segmented mode toggle (Layout / Object) anchored at the
             top of the editor. The two RadioButtons sit inside a rounded
             white "rail" container so the contrast jump goes rail → editor
             (not button → editor). The active half is filled brand blue
             with an inset top shadow ("pressed in" feel); the inactive
             half is transparent against the rail, with secondary-text
             colour. Same pattern as iOS / SwiftUI segmented controls. -->
        <Style Selector="RadioButton.modePill">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22 6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Half-pill corners; nested inside the rail (rail CR=18, padding
             3 → inner CR=14 fits flush). -->
        <Style Selector="RadioButton.modePillLeft">
            <Setter Property="CornerRadius" Value="14 4 4 14"/>
        </Style>
        <Style Selector="RadioButton.modePillRight">
            <Setter Property="CornerRadius" Value="4 14 14 4"/>
        </Style>
        <Style Selector="RadioButton.modePill:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#eef2f7"/>
        </Style>
        <Style Selector="RadioButton.modePill:checked /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BoxShadow" Value="inset 0 2 3 0 #33000000"/>
        </Style>
        <Style Selector="RadioButton.modePill:checked /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
        </Style>
        <Style Selector="RadioButton.modePill:checked:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="RadioButton.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1 1 1 0"/>
            <Setter Property="CornerRadius" Value="4 4 0 0"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
        </Style>
        <Style Selector="RadioButton.tab:checked">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Section caption above each toolbar group. Tiny, uppercase, grey. -->
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 8 0"/>
        </Style>
        <!-- Inline label for sliders ("Opacity", "Saturation", etc.). -->
        <Style Selector="TextBlock.sliderLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8 0 5 0"/>
        </Style>
        <!-- Right-aligned numeric readout next to a slider. Tabular digits +
             fixed width so the slider doesn't reflow as the value scrubs. -->
        <Style Selector="TextBlock.sliderValue">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4 0 0 0"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <!-- Vertical hairline divider between toolbar sections. -->
        <Style Selector="Border.vsep">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderHairlineBrush}"/>
            <Setter Property="Margin" Value="10 2"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <!-- Pill-style toggle buttons: a single chip with the label inside.
             Lit blue when checked. Smooth 120 ms colour transitions on
             state changes so the toggle reads as a deliberate action,
             not an instantaneous snap. -->
        <Style Selector="ToggleButton.pill">
            <Setter Property="Padding" Value="9 3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#c8ccd6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.pill:checked">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="ToggleButton.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#eef2f7"/>
        </Style>
        <Style Selector="ToggleButton.pill:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <!-- Mutual-exclusion pill — same look as ToggleButton.pill but for
             RadioButton, so a group of pills bound to one enum (e.g.
             Floor/Ceiling) reads as a connected segmented selector. -->
        <Style Selector="RadioButton.pill">
            <Setter Property="Padding" Value="9 3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#c8ccd6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.pill:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#eef2f7"/>
        </Style>
        <Style Selector="RadioButton.pill:checked /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="RadioButton.pill:checked /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
        </Style>
        <Style Selector="RadioButton.pill:checked:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <!-- Slim modern slider — full ControlTemplate replacement so we don't
             have to fight the Fluent default's chunky red thumb. Both
             orientations supported. Thin (3 px) track, small (12 px) flat
             blue thumb with a white halo. -->
        <Style Selector="Slider">
            <Setter Property="Background" Value="#dde1e8"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Slider:horizontal">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="0">
                        <Border Height="3" CornerRadius="1.5" Background="#dde1e8" VerticalAlignment="Center"/>
                        <Track Name="PART_Track" Orientation="Horizontal"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Width="12" Height="12" CornerRadius="6"
                                                Background="{DynamicResource AccentBrush}"
                                                BorderBrush="White" BorderThickness="1.5"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider:vertical">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="0">
                        <Border Width="3" CornerRadius="1.5" Background="#dde1e8" HorizontalAlignment="Center"/>
                        <Track Name="PART_Track" Orientation="Vertical"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Width="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Width="12" Height="12" CornerRadius="6"
                                                Background="{DynamicResource AccentBrush}"
                                                BorderBrush="White" BorderThickness="1.5"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Round icon button — used as the colour swatch in the PATHS
             section. Round shape signals "colour" (matches palette puck
             metaphor) and is visually distinct from the square play
             button next to it. -->
        <Style Selector="Button.icon">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <!-- Square media-control button — used for the path animation
             play / stop. Bumped to 26 px for a comfortable hit target;
             rounded-square shape signals "media control" and is visually
             distinct from the round colour swatch beside it. -->
        <Style Selector="Button.play">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerSm}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        </Style>
        <!-- Active state: filled brand-blue while the animation is
             running, so the play/stop button reads as "live". -->
        <Style Selector="Button.play.playing">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
        </Style>
        <!-- Top-bar icon button (undo/redo/overflow). Glyph-only, square,
             tight padding so they read as a tool palette rather than form
             buttons. -->
        <Style Selector="Button.toolIcon">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerSm}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.toolIcon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        </Style>
        <Style Selector="Button.toolIcon:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Keyboard-shortcut chip. Sized to its content; vertically
             centered in its row so a one-letter chip ("R") doesn't
             stretch to match a multi-line description in the same
             row. The inner TextBlock is NoWrap so a long shortcut
             ("Ctrl + Shift + Z") stays on one line. -->
        <Style Selector="Border.kbd">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerSm}"/>
            <Setter Property="Padding" Value="6 2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.kbd > TextBlock">
            <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.kbdDesc">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
    <DockPanel LastChildFill="True">

        <!-- Application menu bar. Hosts file / edit / view / help
             commands so the action bar can stay focused on creative
             actions. Items use platform-standard hotkeys (Ctrl+S /
             Ctrl+O / Ctrl+N) wired through the VM commands. -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource SurfaceSecondaryBrush}"
              BorderBrush="{DynamicResource BorderHairlineBrush}"
              BorderThickness="0 0 0 1"
              Padding="6 2">
            <MenuItem Header="_File">
                <MenuItem Header="_New scene"
                          InputGesture="Ctrl+N"
                          Command="{Binding NewProjectCommand}"/>
                <MenuItem Header="_Open…"
                          InputGesture="Ctrl+O"
                          Command="{Binding OpenProjectCommand}"
                          CommandParameter="{Binding $parent[Window]}"/>
                <MenuItem Header="Open _Recent"
                          ItemsSource="{Binding RecentFiles}">
                    <MenuItem.DataTemplates>
                        <DataTemplate DataType="vm:RecentFileEntry">
                            <MenuItem Header="{Binding Name}"
                                      Click="OnOpenRecent"
                                      Tag="{Binding FullPath}"/>
                        </DataTemplate>
                    </MenuItem.DataTemplates>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Save"
                          InputGesture="Ctrl+S"
                          Command="{Binding SaveProjectCommand}"
                          CommandParameter="{Binding $parent[Window]}"/>
                <MenuItem Header="Save _As…"
                          InputGesture="Ctrl+Shift+S"
                          Command="{Binding SaveProjectAsCommand}"
                          CommandParameter="{Binding $parent[Window]}"/>
                <Separator/>
                <MenuItem Header="_Export">
                    <MenuItem Header="Export _glTF…"
                              Command="{Binding ExportGltfCommand}"
                              CommandParameter="{Binding $parent[Window]}"/>
                    <MenuItem Header="Export _JSON…"
                              Command="{Binding ExportJsonCommand}"
                              CommandParameter="{Binding $parent[Window]}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo"
                          InputGesture="Ctrl+Z"
                          Command="{Binding UndoCommand}"
                          IsEnabled="{Binding CanUndo}"/>
                <MenuItem Header="_Redo"
                          InputGesture="Ctrl+Y"
                          Command="{Binding RedoCommand}"
                          IsEnabled="{Binding CanRedo}"/>
                <Separator/>
                <MenuItem Header="Clear _selection"
                          InputGesture="Escape"
                          Command="{Binding ClearSelectionCommand}"/>
                <MenuItem Header="_Delete room"
                          Command="{Binding DeleteRoomCommand}"
                          IsEnabled="{Binding HasSelectedRoom, FallbackValue=False}"/>
                <Separator/>
                <MenuItem Header="_Reset scene…"
                          Command="{Binding ResetAllCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Top-down"
                          Command="{Binding SetTopViewCommand, FallbackValue=null}"/>
                <MenuItem Header="_3D"
                          Command="{Binding Set3DViewCommand, FallbackValue=null}"/>
                <Separator/>
                <MenuItem Header="_Reset zoom"
                          Command="{Binding ResetViewCommand}"/>
                <MenuItem Header="_Frame selection"
                          InputGesture="F"
                          Command="{Binding FrameSelectionCommand}"/>
                <Separator/>
                <MenuItem Header="T_heme">
                    <MenuItem Header="_Light"
                              Command="{Binding SetLightThemeCommand}"/>
                    <MenuItem Header="_Dark"
                              Command="{Binding SetDarkThemeCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard shortcuts"
                          InputGesture="F1"
                          Command="{Binding ToggleShortcutOverlayCommand}"/>
                <MenuItem Header="_Command palette"
                          InputGesture="Ctrl+K"
                          Command="{Binding OpenCommandPaletteCommand}"/>
                <Separator/>
                <MenuItem Header="_About OpenApparatus Studio…"
                          Click="OnShowAbout"/>
            </MenuItem>
        </Menu>

        <!-- Top action bar. Document title + unsaved indicator on the
             left, command cluster on the right. Undo/Redo are glyph-only
             icon buttons; Random Fill is text (Layout-mode only); Reset
             is demoted into an overflow menu; Export is one SplitButton-
             style flyout (glTF is the goal-state, JSON is alternate). -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="0 0 0 1" Padding="14 6">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- Brand / project title. Editable would require a TextBox;
                     start with a static label that's easy to swap out later. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Unsaved-changes indicator. Ellipse fills brand-blue
                         when there are unsaved edits and gracefully fades
                         in/out via the Opacity transition rather than
                         popping. -->
                    <Ellipse Width="8" Height="8"
                             Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center"
                             Opacity="{Binding HasUnsavedChanges, Converter={x:Static converters:BoolToTextConverter.Instance}, ConverterParameter='1|0', FallbackValue=0}"
                             ToolTip.Tip="Unsaved changes">
                        <Ellipse.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                            </Transitions>
                        </Ellipse.Transitions>
                    </Ellipse>
                    <TextBlock Text="OpenApparatus Studio"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontBodyStrong}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="·"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProjectTitle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontBody}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action cluster. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="toolIcon"
                            Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                            ToolTip.Tip="Undo (Ctrl+Z)"
                            AutomationProperties.Name="Undo">
                        <views:Icon Symbol="Undo"/>
                    </Button>
                    <Button Classes="toolIcon"
                            Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                            ToolTip.Tip="Redo (Ctrl+Y / Ctrl+Shift+Z)"
                            AutomationProperties.Name="Redo">
                        <views:Icon Symbol="Redo"/>
                    </Button>
                    <Border Classes="vsep" Margin="6 4"/>
                    <Button Content="Random Fill" Command="{Binding RandomFillCommand}"
                            IsVisible="{Binding IsLayoutMode}"
                            Padding="10 5"
                            ToolTip.Tip="Generate a random room layout"/>
                    <!-- The single-item ⋯ overflow used to live here.
                         Reset All is in the Edit menu instead, so the
                         ghost-affordance dot is gone. -->
                    <Border Classes="vsep" Margin="6 4"/>
                    <!-- Single Export entry-point; the flyout offers the two
                         formats so the bar isn't dominated by export buttons. -->
                    <Button Classes="primary" Padding="12 5"
                            ToolTip.Tip="Export the scene…">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <views:Icon Symbol="Download" Size="14"/>
                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                            <views:Icon Symbol="ChevronDown" Size="11"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Export glTF…"
                                          Command="{Binding ExportGltfCommand}"
                                          CommandParameter="{Binding $parent[Window]}"/>
                                <MenuItem Header="Export JSON…"
                                          Command="{Binding ExportJsonCommand}"
                                          CommandParameter="{Binding $parent[Window]}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Modern single-row settings strip. Sections separated by
             hairline dividers; each section labelled with a tiny
             uppercase caption. Wrapped in a horizontal ScrollViewer so
             on narrow windows the strip can scroll instead of clipping
             or wrapping. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="0 0 0 1" Padding="14 8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PointerWheelChanged="OnToolbarWheel">
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">

                    <!-- ── VIEW (camera) — always visible ── -->
                    <TextBlock Classes="sectionLabel" Text="VIEW"/>
                    <RadioButton GroupName="CameraView"
                                 Classes="pill"
                                 Content="Top"
                                 IsChecked="{Binding CameraView, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=TopDown}"
                                 ToolTip.Tip="Top-down editing view."/>
                    <RadioButton GroupName="CameraView"
                                 Classes="pill"
                                 Content="3D"
                                 Margin="0 0 6 0"
                                 IsChecked="{Binding CameraView, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Iso}"
                                 ToolTip.Tip="Real-mesh 3D viewer (orbit / pan / zoom, read-only)."/>

                    <!-- ── SURFACE (top-down only) — surface kind toggle +
                         per-room visual layers. Hidden in 3D where these
                         have no meaning (3D paints the actual mesh). -->
                    <Border Classes="vsep" IsVisible="{Binding IsTopDownView}"/>
                    <TextBlock Classes="sectionLabel" Text="SURFACE"
                               IsVisible="{Binding IsTopDownView}"/>
                    <RadioButton GroupName="ViewSurface"
                                 Classes="pill"
                                 Content="Floor"
                                 IsVisible="{Binding ShowFloorCeilingTabs}"
                                 IsChecked="{Binding ViewMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Floor}"
                                 ToolTip.Tip="Show floor tile colours."/>
                    <RadioButton GroupName="ViewSurface"
                                 Classes="pill"
                                 Content="Ceiling"
                                 Margin="0 0 6 0"
                                 IsVisible="{Binding ShowFloorCeilingTabs}"
                                 IsChecked="{Binding ViewMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Ceiling}"
                                 ToolTip.Tip="Show ceiling tile colours."/>
                    <ToggleButton Classes="pill" Content="Borders"
                                  IsVisible="{Binding IsTopDownView}"
                                  IsChecked="{Binding ShowWallBorders}"
                                  ToolTip.Tip="14-px coloured ribbons inside each wall."/>
                    <ToggleButton Classes="pill" Content="Labels"
                                  IsVisible="{Binding IsTopDownView}"
                                  IsChecked="{Binding ShowRoomLabels}"
                                  ToolTip.Tip="Room id + name at room centre."/>
                    <!-- Opacity only meaningful when Borders is on AND
                         we're in top-down. Saturation only matters in
                         top-down (3D doesn't tint tiles). -->
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center"
                                IsVisible="{Binding ShowOpacitySlider}">
                        <TextBlock Classes="sliderLabel" Text="Opacity"/>
                        <Slider Width="76" Minimum="0" Maximum="1"
                                Value="{Binding WallBorderOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Wall border opacity."/>
                        <TextBlock Classes="sliderValue"
                                   Text="{Binding WallBorderOpacity, StringFormat={}{0:0.00}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center"
                                IsVisible="{Binding IsTopDownView}">
                        <TextBlock Classes="sliderLabel" Text="Saturation"/>
                        <Slider Width="76" Minimum="0" Maximum="1"
                                Value="{Binding TileSaturation, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Tile colour saturation."/>
                        <TextBlock Classes="sliderValue"
                                   Text="{Binding TileSaturation, StringFormat={}{0:0.00}}"/>
                    </StackPanel>

                    <Border Classes="vsep" IsVisible="{Binding ShowLayoutMeasurements}"/>

                    <!-- ── ROOM measurements (top-down only) ── -->
                    <TextBlock Classes="sectionLabel" Text="ROOM"
                               IsVisible="{Binding ShowLayoutMeasurements}"/>
                    <ToggleButton Classes="pill" Content="Dimensions"
                                  IsVisible="{Binding ShowLayoutMeasurements}"
                                  IsChecked="{Binding ShowRoomDimensions}"
                                  ToolTip.Tip="W × D label per room."/>
                    <ToggleButton Classes="pill" Content="Area"
                                  IsVisible="{Binding ShowLayoutMeasurements}"
                                  IsChecked="{Binding ShowFloorAreaLabels}"
                                  ToolTip.Tip="m² label per room."/>
                    <ToggleButton Classes="pill" Content="Openings"
                                  IsVisible="{Binding ShowLayoutMeasurements}"
                                  IsChecked="{Binding ShowOpeningSizeLabels}"
                                  ToolTip.Tip="Width × height per door / window."/>

                    <Border Classes="vsep" IsVisible="{Binding ShowObjectMeasurements}"/>

                    <!-- ── OBJECT measurements (top-down only). Renamed
                         "Distances" → "Object distances" to disambiguate
                         from the door-related entries beside it. -->
                    <TextBlock Classes="sectionLabel" Text="MEASURE"
                               IsVisible="{Binding ShowObjectMeasurements}"/>
                    <ToggleButton Classes="pill" Content="Object distances"
                                  IsVisible="{Binding ShowObjectMeasurements}"
                                  IsChecked="{Binding ShowObjectDistances}"
                                  ToolTip.Tip="Inter-object distance line + label."/>
                    <ToggleButton Classes="pill" Content="Door angles"
                                  IsVisible="{Binding ShowObjectMeasurements}"
                                  IsChecked="{Binding ShowDoorAngles}"
                                  ToolTip.Tip="Angle arc + |angle| label at every door, plus 0° tick."/>
                    <ToggleButton Classes="pill" Content="Door distances"
                                  IsVisible="{Binding ShowObjectMeasurements}"
                                  IsChecked="{Binding ShowDoorDistances}"
                                  ToolTip.Tip="Door→object line + distance label."/>

                    <Border Classes="vsep" IsVisible="{Binding ShowPathsSection}"/>

                    <!-- ── PATHS (top-down only) ── -->
                    <TextBlock Classes="sectionLabel" Text="PATHS"
                               IsVisible="{Binding ShowPathsSection}"/>
                    <ToggleButton Classes="pill" Content="Show"
                                  IsVisible="{Binding ShowPathsSection}"
                                  IsChecked="{Binding ShowPaths}"
                                  ToolTip.Tip="Polyline through every traversable wall (open / doorway)."/>
                    <!-- Round colour swatch with a tiny "•" affordance dot
                         layered on top so the control reads as clickable
                         (otherwise it looks like a non-interactive bead). -->
                    <Grid Margin="2 0 0 0"
                          IsVisible="{Binding ShowPathsSection}"
                          VerticalAlignment="Center">
                        <Button Classes="icon"
                                BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1"
                                Background="{Binding PathColor, Converter={x:Static converters:Vector3ToBrushConverter.Instance}}"
                                Click="OnPickPathColor"
                                ToolTip.Tip="Path overlay colour"/>
                        <TextBlock Text="…" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0 0 3 0"
                                   Foreground="{DynamicResource TextOnDarkBrush}"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <!-- Square media-control button. Filled brand-blue while
                         the animation is running so the button reads as
                         "live" (matches DAW play-state conventions). -->
                    <Button Classes="play"
                            Classes.playing="{Binding IsPathAnimating}"
                            Margin="4 0 0 0"
                            IsVisible="{Binding ShowPathsSection}"
                            Command="{Binding TogglePathAnimationCommand}"
                            ToolTip.Tip="Animate the path overlay. Loops while running.">
                        <Panel>
                            <views:Icon Symbol="Play" Size="11"
                                        IsVisible="{Binding !IsPathAnimating}"/>
                            <views:Icon Symbol="Stop" Size="11"
                                        IsVisible="{Binding IsPathAnimating}"/>
                        </Panel>
                    </Button>
                    <!-- Speed slider, only while the animation is running.
                         0.25× = slow study; 4× = quick reveal. -->
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center"
                                IsVisible="{Binding IsPathAnimating}"
                                Margin="6 0 0 0">
                        <TextBlock Classes="sliderLabel" Text="Speed"/>
                        <Slider Width="64" Minimum="0.25" Maximum="4"
                                Value="{Binding PathAnimationSpeed, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Animation speed (0.25× — 4×)."/>
                        <TextBlock Classes="sliderValue"
                                   Text="{Binding PathAnimationSpeed, StringFormat={}{0:0.0}×}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Multi-cell status bar — three columns:
              left   cursor world position (top-down only)
              centre live status message + accent dot
              right  scene summary (room / object / mode counts) -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBgBrush}" Padding="14 6">
            <Grid ColumnDefinitions="*,2*,*" VerticalAlignment="Center">
                <!-- Cursor position. Hidden when cursor isn't over the
                     canvas or in 3D mode (where 2D coords don't apply). -->
                <TextBlock Grid.Column="0"
                           Text="{Binding CursorWorldDisplay}"
                           Foreground="#A8AEBB"
                           FontSize="{StaticResource FontCaption}"
                           FontFamily="Consolas, 'Courier New', monospace"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <!-- Live message + contextual hint. The brand-blue dot
                     only lights when there's an active StatusMessage; the
                     hint takes over when the message is empty (auto-cleared
                     after 6 s) so the centre never just sits blank. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}"
                             IsVisible="{Binding HasStatusMessage}"/>
                    <TextBlock IsVisible="{Binding HasStatusMessage}"
                               Text="{Binding StatusMessage}"
                               Foreground="#E5E7EC"
                               FontSize="{StaticResource FontBody}"
                               VerticalAlignment="Center"/>
                    <TextBlock IsVisible="{Binding !HasStatusMessage}"
                               Text="{Binding ContextualHint}"
                               Foreground="#A8AEBB"
                               FontSize="{StaticResource FontCaption}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Scene summary. -->
                <TextBlock Grid.Column="2"
                           Text="{Binding SceneSummary}"
                           Foreground="#A8AEBB"
                           FontSize="{StaticResource FontCaption}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Three-pane layout with GridSplitters between panels so the
             user can resize side panels. Stars allow the centre to flex
             on window resize. Min widths prevent panels collapsing into
             nothing. Splitter widths sit on top of the column boundaries
             so they don't take their own column space. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="280" MinWidth="240"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" Background="{DynamicResource SurfacePrimaryBrush}">
                <StackPanel Margin="12" Spacing="0">

                    <!-- ─── LAYOUT MODE LEFT PANEL ─── -->
                    <StackPanel IsVisible="{Binding IsLayoutMode}" Spacing="0">
                        <TextBlock Classes="label" Text="Actions"/>
                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <!-- Create Room: disabled when no tiles are
                                     selected (the command short-circuits but
                                     the disabled state communicates "you need
                                     a selection" without requiring a click). -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="primary"
                                            Command="{Binding CreateRoomFromSelectionCommand}"
                                            IsEnabled="{Binding HasSelectedTiles}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Create Room"/>
                                            <Border Background="#33FFFFFF" CornerRadius="3" Padding="4 1">
                                                <TextBlock Text="R" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <!-- Selection-count helper visible only when
                                     there's a selection. Tells the user how
                                     big the resulting room will be. -->
                                <TextBlock IsVisible="{Binding HasSelectedTiles}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           Text="{Binding SelectedTilesCount, StringFormat='{}{0} tile(s) selected'}"/>
                                <!-- Disabled when nothing is selected — the
                                     control reads as actionable only when
                                     it actually does something. -->
                                <Button Classes="action"
                                        IsEnabled="{Binding HasSelectedTiles}"
                                        Command="{Binding ClearSelectionCommand}"
                                        ToolTip.Tip="Drop the highlighted tiles without creating a room.">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock Text="Clear tile selection"/>
                                        <Border BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="3" Padding="4 1">
                                            <TextBlock Text="Esc" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="label" Text="Defaults for new rooms"/>
                        <Border Classes="section">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                                <!-- Each default is now a row: caption +
                                     visible colour swatch button. Clicking
                                     the swatch opens the picker. The current
                                     colour is on display so users don't have
                                     to open the picker just to remember it. -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="propLabel" Text="Floor"/>
                                <Button Grid.Row="0" Grid.Column="1"
                                        Click="OnPickDefaultFloor"
                                        Padding="0" MinHeight="0" Height="24"
                                        HorizontalAlignment="Stretch"
                                        BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1"
                                        CornerRadius="4"
                                        Background="{Binding DefaultFloorColor, Converter={x:Static converters:Vector3ToBrushConverter.Instance}}"
                                        ToolTip.Tip="Click to change. Used when a new room is created."/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="Ceiling"/>
                                <Button Grid.Row="1" Grid.Column="1"
                                        Click="OnPickDefaultCeiling"
                                        Padding="0" MinHeight="0" Height="24"
                                        HorizontalAlignment="Stretch"
                                        BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1"
                                        CornerRadius="4"
                                        Background="{Binding DefaultCeilingColor, Converter={x:Static converters:Vector3ToBrushConverter.Instance}}"
                                        ToolTip.Tip="Click to change. Used when a new room is created."/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="propLabel" Text="Walls"/>
                                <!-- Wall row: swatch on the left, "Random"
                                     toggle on the right. When Random is on,
                                     the swatch shows a horizontal rainbow
                                     gradient signalling "every new room
                                     gets its own hue"; clicks still open
                                     the colour picker for the fallback
                                     fixed-colour value. -->
                                <Grid Grid.Row="2" Grid.Column="1"
                                      ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <Button Grid.Column="0"
                                            Click="OnPickDefaultWall"
                                            Padding="0" MinHeight="0" Height="24"
                                            HorizontalAlignment="Stretch"
                                            BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{Binding WallDefaultBrush}"
                                            ToolTip.Tip="Click to change the fixed colour. The rainbow appears when Random is on; new rooms then get a fresh hue each."/>
                                    <ToggleButton Grid.Column="1"
                                                  Classes="pill"
                                                  Content="Random"
                                                  Padding="8 2"
                                                  Margin="0"
                                                  IsChecked="{Binding UseRandomDefaultWallColor, Mode=TwoWay}"
                                                  ToolTip.Tip="Roll a fresh hue for every new room's walls."/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Document settings — flat cards, one per group.
                             Numeric rows mirror ConstraintsPanel.NumericRow:
                             a small label above a stock NumericUpDown so
                             both panels read as one system. DragScrub is
                             still wired through the labels. -->
                        <TextBlock Classes="label" Text="Document settings"/>

                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Grid" FontWeight="SemiBold" Margin="0 0 0 2"/>
                                <StackPanel Margin="0 0 0 4">
                                    <TextBlock Classes="propLabel" Text="Width (tiles)"
                                               FontSize="11" Margin="0 0 0 2"
                                               behaviors:DragScrub.Target="{Binding #gridWidthInput}"
                                               behaviors:DragScrub.Step="0.2"/>
                                    <NumericUpDown Name="gridWidthInput" Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding GridWidth}" Minimum="1" Maximum="64" FormatString="0"/>
                                </StackPanel>
                                <StackPanel Margin="0 0 0 4">
                                    <TextBlock Classes="propLabel" Text="Length (tiles)"
                                               FontSize="11" Margin="0 0 0 2"
                                               behaviors:DragScrub.Target="{Binding #gridLengthInput}"
                                               behaviors:DragScrub.Step="0.2"/>
                                    <NumericUpDown Name="gridLengthInput" Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding GridLength}" Minimum="1" Maximum="64" FormatString="0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="propLabel" Text="Tile size (m)"
                                               FontSize="11" Margin="0 0 0 2"
                                               behaviors:DragScrub.Target="{Binding #tileSizeInput}"
                                               behaviors:DragScrub.Step="0.05"/>
                                    <NumericUpDown Name="tileSizeInput" Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding TileSize}" Minimum="0.5" Maximum="10" Increment="0.5" FormatString="0.0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Walls" FontWeight="SemiBold" Margin="0 0 0 2"/>
                                <StackPanel Margin="0 0 0 4">
                                    <TextBlock Classes="propLabel" Text="Thickness (m)"
                                               FontSize="11" Margin="0 0 0 2"
                                               behaviors:DragScrub.Target="{Binding #wallThicknessInput}"
                                               behaviors:DragScrub.Step="0.01"/>
                                    <NumericUpDown Name="wallThicknessInput" Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding WallThickness}" Minimum="0.05" Maximum="2.0" Increment="0.05" FormatString="0.00"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="propLabel" Text="Height (m)"
                                               FontSize="11" Margin="0 0 0 2"
                                               behaviors:DragScrub.Target="{Binding #wallHeightInput}"
                                               behaviors:DragScrub.Step="0.05"/>
                                    <NumericUpDown Name="wallHeightInput" Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding WallHeight}" Minimum="0.5" Maximum="6.0" Increment="0.5" FormatString="0.0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Doorways" FontWeight="SemiBold" Margin="0 0 0 2"/>
                                <StackPanel Margin="0 0 0 4">
                                    <TextBlock Classes="propLabel" Text="Width (m)"
                                               FontSize="11" Margin="0 0 0 2"
                                               behaviors:DragScrub.Target="{Binding #doorWidthInput}"
                                               behaviors:DragScrub.Step="0.02"/>
                                    <NumericUpDown Name="doorWidthInput" Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding DoorWidth}" Minimum="0.5" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="propLabel" Text="Height (m)"
                                               FontSize="11" Margin="0 0 0 2"
                                               behaviors:DragScrub.Target="{Binding #doorHeightInput}"
                                               behaviors:DragScrub.Step="0.02"/>
                                    <NumericUpDown Name="doorHeightInput" Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding DoorHeight}" Minimum="1.5" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Windows" FontWeight="SemiBold" Margin="0 0 0 2"/>
                                <StackPanel Margin="0 0 0 4">
                                    <TextBlock Classes="propLabel" Text="Width (m)"
                                               FontSize="11" Margin="0 0 0 2"
                                               behaviors:DragScrub.Target="{Binding #winWidthInput}"
                                               behaviors:DragScrub.Step="0.02"/>
                                    <NumericUpDown Name="winWidthInput" Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding WindowWidth}" Minimum="0.3" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                                </StackPanel>
                                <StackPanel Margin="0 0 0 4">
                                    <TextBlock Classes="propLabel" Text="Head height (m)"
                                               FontSize="11" Margin="0 0 0 2"
                                               behaviors:DragScrub.Target="{Binding #winHeightInput}"
                                               behaviors:DragScrub.Step="0.02"/>
                                    <NumericUpDown Name="winHeightInput" Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding WindowHeight}" Minimum="1.0" Maximum="4.0" Increment="0.1" FormatString="0.0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="propLabel" Text="Sill height (m)"
                                               FontSize="11" Margin="0 0 0 2"
                                               behaviors:DragScrub.Target="{Binding #winSillInput}"
                                               behaviors:DragScrub.Step="0.02"/>
                                    <NumericUpDown Name="winSillInput" Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding WindowSillHeight}" Minimum="0.1" Maximum="2.5" Increment="0.1" FormatString="0.0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- First-run helper. Hides once the user creates
                             their first room. Each tip uses the same
                             kbd-chip + description vocabulary as the F1
                             overlay so it reads as part of the same
                             system, not a separate panel. -->
                        <TextBlock Classes="label" Text="Getting started"
                                   IsVisible="{Binding HasNoRooms}"/>
                        <Border Classes="section" IsVisible="{Binding HasNoRooms}">
                            <Grid ColumnDefinitions="Auto,*" RowSpacing="10" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Classes="kbd"><TextBlock Text="Drag"/></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="kbdDesc"
                                           Text="Click and drag empty tiles to mark a footprint."
                                           TextWrapping="Wrap"/>
                                <Border Grid.Row="1" Grid.Column="0" Classes="kbd"><TextBlock Text="R"/></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="kbdDesc"
                                           Text="Turn the selection into a room."
                                           TextWrapping="Wrap"/>
                                <!-- Each opening-mode key gets its own kbd chip
                                     so they read as four discrete keys instead
                                     of one mashed gesture. -->
                                <StackPanel Grid.Row="2" Grid.Column="0"
                                            Orientation="Horizontal" Spacing="3"
                                            VerticalAlignment="Center">
                                    <Border Classes="kbd"><TextBlock Text="D"/></Border>
                                    <Border Classes="kbd"><TextBlock Text="W"/></Border>
                                    <Border Classes="kbd"><TextBlock Text="O"/></Border>
                                    <Border Classes="kbd"><TextBlock Text="C"/></Border>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="kbdDesc"
                                           Text="With a wall selected: door · window · open · closed."
                                           TextWrapping="Wrap"/>
                                <Border Grid.Row="3" Grid.Column="0" Classes="kbd"><TextBlock Text="F1"/></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="kbdDesc"
                                           Text="Open the full keyboard reference."
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ─── OBJECT MODE LEFT PANEL ─── -->
                    <StackPanel IsVisible="{Binding IsObjectsMode}" Spacing="0">
                        <TextBlock Classes="label" Text="Defaults for new objects"/>
                        <Border Classes="section">
                            <StackPanel Spacing="8">
                                <!-- Stacked label-above-input rows so the
                                     numeric inputs use their full width and
                                     the up/down arrows sit at the right edge,
                                     matching the placement-constraints
                                     layout. -->
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="propLabel" Text="Default Y (m)"
                                               ToolTip.Tip="Initial height above floor for newly placed objects."/>
                                    <NumericUpDown Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding DefaultObjectY}"
                                                   Minimum="0" Maximum="3.0" Increment="0.05" FormatString="0.00"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="propLabel" Text="Sub-grid"
                                               ToolTip.Tip="Each tile is divided into N×N sub-cells. 1 = no subdivision."/>
                                    <NumericUpDown Classes="compact"
                                                   HorizontalAlignment="Stretch"
                                                   Value="{Binding GridSubdivision}"
                                                   Minimum="1" Maximum="8" Increment="1" FormatString="0"/>
                                </StackPanel>
                                <!-- One-line helper unpacking what "sub-grid"
                                     does. Avoids a tooltip-only explanation
                                     for a concept the user will hit straight
                                     away. -->
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="{StaticResource FontCaption}"
                                           Text="Each tile splits into N × N placement cells. 1 = whole tile."/>
                                <Button Content="Snap objects to grid" Classes="action"
                                        Command="{Binding SnapObjectsToGridCommand}"
                                        ToolTip.Tip="Round every object's X/Z to the nearest sub-cell centre. Y is preserved."/>
                            </StackPanel>
                        </Border>

                        <!-- Object types list (moved from right panel). The
                             panel itself is hosted as a UserControl so the
                             code-behind can rebuild rows dynamically. -->
                        <views:ObjectTypesPanel/>

                        <!-- Placement constraints (always visible in Object
                             mode — used to live in its own panel). -->
                        <views:ConstraintsPanel/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0" Background="{DynamicResource EditorBgBrush}">
                        <Grid>
                            <views:GridEditorView EditVersion="{Binding EditVersion}" Margin="8">
                                <views:GridEditorView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Frame selection (F)"
                                                  Command="{Binding FrameSelectionCommand}"/>
                                        <MenuItem Header="Reset view"
                                                  Command="{Binding ResetViewCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Clear selection"
                                                  Command="{Binding ClearSelectionCommand}"/>
                                        <MenuItem Header="Random fill"
                                                  IsVisible="{Binding IsLayoutMode}"
                                                  Command="{Binding RandomFillCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Switch to Top view"
                                                  IsVisible="{Binding IsIsoView}"
                                                  Command="{Binding SetTopViewCommand}"/>
                                        <MenuItem Header="Switch to 3D view"
                                                  IsVisible="{Binding IsTopDownView}"
                                                  Command="{Binding Set3DViewCommand}"/>
                                    </ContextMenu>
                                </views:GridEditorView.ContextMenu>
                            </views:GridEditorView>
                            <!-- Welcome screen — overlays the editor when no
                                 project is open and no rooms exist. -->
                            <views:WelcomePanel/>
                            <!-- Floating Layout / Object segmented control,
                                 anchored top-centre over the editor. White
                                 rail with rounded ends; inactive half blends
                                 with the rail, active half is brand-blue with
                                 an inset top shadow. Soft drop shadow on the
                                 rail lifts the whole control off the dark
                                 editor surface. -->
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0 14 0 0"
                                    Padding="3"
                                    CornerRadius="18"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                                    BorderThickness="1"
                                    BoxShadow="{DynamicResource Elevation2}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="EditMode"
                                                 Classes="modePill modePillLeft"
                                                 IsChecked="{Binding EditMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Layout}"
                                                 ToolTip.Tip="Layout mode — rooms, walls, openings">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <views:Icon Symbol="Layout" Size="14"/>
                                            <TextBlock Text="Layout" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="EditMode"
                                                 Classes="modePill modePillRight"
                                                 IsChecked="{Binding EditMode, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter=Object}"
                                                 ToolTip.Tip="Object mode — place, move, edit objects">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <views:Icon Symbol="Cube" Size="14"/>
                                            <TextBlock Text="Object" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Zoom rail (top-down only). In 3D the wheel handles
                         dolly distance and a separate slider would be
                         duplicative + take 48 px. -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderHairlineBrush}"
                            BorderThickness="1 0 0 0" Padding="6 10" Width="48"
                            IsVisible="{Binding IsTopDownView}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Zoom" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontCaption}"/>
                            <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="{StaticResource FontCaption}"
                                       Margin="0 0 0 4"
                                       Text="{Binding ZoomFactor, StringFormat={}{0:0.0}×}"/>
                            <!-- Fit + Reset stacked at the bottom. Fit
                                 shrinks the view to encompass the entire
                                 grid; Reset returns to the default 1× view. -->
                            <Button DockPanel.Dock="Bottom" Content="Reset" FontSize="10" Padding="4 2"
                                    HorizontalAlignment="Stretch"
                                    Margin="0 4 0 0"
                                    Command="{Binding ResetViewCommand}"
                                    ToolTip.Tip="Reset zoom and pan to fit-to-view."/>
                            <Button DockPanel.Dock="Bottom" Content="Fit" FontSize="10" Padding="4 2"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ResetViewCommand}"
                                    ToolTip.Tip="Fit the entire grid in the viewport."/>
                            <Slider Orientation="Vertical"
                                    Minimum="0.5" Maximum="8.0"
                                    Value="{Binding ZoomFactor, Mode=TwoWay}"
                                    HorizontalAlignment="Center"
                                    Margin="0 6"/>
                        </DockPanel>
                    </Border>
                </Grid>
                <!-- Legend bar — irrelevant in 3D where the meshes carry
                     their own visual vocabulary. Hidden when CameraView
                     is Iso. -->
                <views:LegendBar Grid.Row="1" IsVisible="{Binding IsTopDownView}"/>
            </Grid>

            <views:RoomEditorPanel Grid.Column="2"/>

            <!-- Splitters sit on top of the column boundaries so the user
                 can drag the side-panel widths. Cursor changes to
                 SizeWestEast on hover; 5-px hit area is wider than the
                 visible 1-px hairline. -->
            <GridSplitter Grid.Column="0" HorizontalAlignment="Right"
                          Width="5" Background="Transparent"
                          ResizeDirection="Columns"
                          ZIndex="100"/>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Right"
                          Width="5" Background="Transparent"
                          ResizeDirection="Columns"
                          ZIndex="100"/>
        </Grid>
    </DockPanel>

    <!-- Toast layer — bottom-right transient confirmations + Undo. -->
    <views:ToastsLayer/>

    <!-- Command palette overlay (Ctrl+K). Backdrop dim + centred input
         + filtered command list. Hidden by default; shown via
         IsOpen binding. -->
    <views:CommandPalette x:Name="CommandPalette"
                          IsOpen="{Binding IsCommandPaletteOpen, Mode=TwoWay}"/>

    <!-- Keyboard-shortcut help overlay. Toggled with F1; click the
         backdrop or press the close button to dismiss. -->
    <Grid IsVisible="{Binding IsShortcutOverlayVisible}"
          Background="#88000000">
        <Grid.GestureRecognizers>
            <!-- Click backdrop dismisses. -->
        </Grid.GestureRecognizers>
        <Button Background="Transparent" BorderBrush="Transparent"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding DismissShortcutOverlayCommand}"
                Cursor="Arrow"/>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="420" MaxWidth="520"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerLg}"
                BoxShadow="{DynamicResource Elevation2}"
                Padding="22 18">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Keyboard shortcuts"
                               FontWeight="SemiBold" FontSize="{StaticResource FontTitle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="toolIcon"
                            Command="{Binding DismissShortcutOverlayCommand}"
                            ToolTip.Tip="Close (Esc)"
                            AutomationProperties.Name="Close help overlay">
                        <views:Icon Symbol="Close"/>
                    </Button>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderHairlineBrush}"/>

                <!-- Shortcuts grouped by category. Each group has a tiny
                     uppercase header followed by a kbd | description grid. -->
                <StackPanel Spacing="14">
                    <!-- Editing -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="sectionLabel" Text="EDITING"/>
                        <Grid ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Classes="kbd"><TextBlock Text="R"/></Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="kbdDesc" Text="Create room from selected tiles"/>
                            <Border Grid.Row="1" Grid.Column="0" Classes="kbd"><TextBlock Text="D / W / O / C"/></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="kbdDesc" Text="On a selected wall: door / window / open / closed"/>
                            <Border Grid.Row="2" Grid.Column="0" Classes="kbd"><TextBlock Text="1 – 9"/></Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="kbdDesc" Text="Place an object of that type (Object mode)"/>
                            <Border Grid.Row="3" Grid.Column="0" Classes="kbd"><TextBlock Text="Delete / Backspace"/></Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="kbdDesc" Text="Delete the selected opening or object"/>
                            <Border Grid.Row="4" Grid.Column="0" Classes="kbd"><TextBlock Text="Esc"/></Border>
                            <TextBlock Grid.Row="4" Grid.Column="1" Classes="kbdDesc" Text="Clear selection / dismiss this overlay"/>
                        </Grid>
                    </StackPanel>

                    <!-- History -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="sectionLabel" Text="HISTORY"/>
                        <Grid ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Classes="kbd"><TextBlock Text="Ctrl + Z"/></Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="kbdDesc" Text="Undo"/>
                            <Border Grid.Row="1" Grid.Column="0" Classes="kbd"><TextBlock Text="Ctrl + Y / Ctrl + Shift + Z"/></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="kbdDesc" Text="Redo"/>
                        </Grid>
                    </StackPanel>

                    <!-- View / Navigation -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="sectionLabel" Text="VIEW"/>
                        <Grid ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Classes="kbd"><TextBlock Text="Mouse wheel"/></Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="kbdDesc" Text="Zoom (top-down) / dolly (3D)"/>
                            <Border Grid.Row="1" Grid.Column="0" Classes="kbd"><TextBlock Text="Right / middle drag"/></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="kbdDesc" Text="Pan the canvas / 3D camera pivot"/>
                            <Border Grid.Row="2" Grid.Column="0" Classes="kbd"><TextBlock Text="Left drag (3D)"/></Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="kbdDesc" Text="Orbit the 3D camera"/>
                        </Grid>
                    </StackPanel>

                    <!-- Help -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="sectionLabel" Text="HELP"/>
                        <Grid ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="14">
                            <Border Grid.Column="0" Classes="kbd"><TextBlock Text="F1"/></Border>
                            <TextBlock Grid.Column="1" Classes="kbdDesc" Text="Toggle this help overlay"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Tip: drag a property label horizontally to scrub its value (Shift = fine, Ctrl = coarse)."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{StaticResource FontBody}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
