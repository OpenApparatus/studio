<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenApparatus.Studio.Views.Png2DExportDialog"
        Width="380" Height="500"
        Title="Export 2D view as PNG"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfacePrimaryBrush}">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0"
                   FontWeight="SemiBold" FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0 0 0 4"
                   Text="Layers to include"/>
        <TextBlock Grid.Row="0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0 22 0 10"
                   Text="The PNG mirrors the current 2D viewport at 2× resolution."/>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6">
                <TextBlock Classes="sectionLabel" Text="LAYOUT"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           Margin="0 4 0 2"/>
                <CheckBox x:Name="ChkRibbons"     Content="Walls (coloured borders)"/>
                <CheckBox x:Name="ChkRoomLabels"  Content="Room labels (id + name)"/>
                <CheckBox x:Name="ChkAxisMarkers" Content="Grid dimensions (axis ticks)"/>
                <CheckBox x:Name="ChkPlacement"   Content="Valid placement highlights"/>
                <CheckBox x:Name="ChkLegend"      Content="Legend bar"/>

                <TextBlock Classes="sectionLabel" Text="ROOM MEASUREMENTS"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           Margin="0 10 0 2"/>
                <CheckBox x:Name="ChkRoomDims"    Content="Dimensions (W × D)"/>
                <CheckBox x:Name="ChkFloorArea"   Content="Floor area (m²)"/>
                <CheckBox x:Name="ChkOpenings"    Content="Door / window sizes"/>

                <TextBlock Classes="sectionLabel" Text="OBJECT MEASUREMENTS"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           Margin="0 10 0 2"/>
                <CheckBox x:Name="ChkObjectDist"  Content="Object distances"/>
                <CheckBox x:Name="ChkDoorAngles"  Content="Door angles"/>
                <CheckBox x:Name="ChkDoorDist"    Content="Door distances"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0 8 0 0">
            <Button Content="Match current view" Click="OnMatchCurrent"
                    ToolTip.Tip="Set checkboxes to match what's currently shown in the editor."/>
            <Button Content="All on"  Click="OnAllOn"/>
            <Button Content="All off" Click="OnAllOff"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button Content="Cancel" Click="OnCancel"/>
            <Button Content="Export…" Classes="primary" Click="OnExport" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
