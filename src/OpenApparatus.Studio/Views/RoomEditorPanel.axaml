<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenApparatus.Studio.ViewModels"
             x:Class="OpenApparatus.Studio.Views.RoomEditorPanel"
             x:DataType="vm:MainWindowViewModel"
             MinWidth="220">
    <!-- Width managed by the parent GridSplitter; just enforce a minimum. -->
    <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1 0 0 0">
        <ScrollViewer>
            <StackPanel Margin="14" Spacing="0" x:Name="Body">
                <!-- Populated by code-behind: shows opening editor when an
                     opening is selected, room editor when a room is selected,
                     or hides when neither. -->
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
